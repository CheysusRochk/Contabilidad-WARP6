      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap');\n  .fig { font-family:'IBM Plex Mono', monospace; font-variant-numeric: tabular-nums; }\n</style>\n<link data-kid=\"1\" data-name=\"Tabler icon font stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"min-h-screen bg-[#F4F8FC] text-[#17324D] antialiased\" data-kid=\"2\" data-name=\"Application dashboard wrapper\" style=\"font-family:'Inter',sans-serif\">\n    <!-- ===== Left rail ===== -->\n    <aside class=\"fixed inset-y-0 left-0 w-[228px] bg-white border-r border-[#D7E2EC] flex flex-col z-20\" data-kid=\"2-1\" data-name=\"Left sidebar navigation panel\">\n        <div class=\"px-5 h-16 flex items-center gap-2.5 border-b border-[#D7E2EC]/70\" data-kid=\"2-1-1\" data-name=\"Company branding header\">\n            <div class=\"w-8 h-8 rounded-[8px] bg-[#2B68E8] text-white flex items-center justify-center text-[12px] font-semibold tracking-tight shrink-0\" data-kid=\"2-1-1-1\" data-name=\"Company logo placeholder\">\n                W6\n            </div>\n            <div class=\"leading-tight\" data-kid=\"2-1-1-2\" data-name=\"Company details container\">\n                <div class=\"text-[14px] font-semibold tracking-tight\" data-kid=\"2-1-1-2-1\" data-name=\"Company name text\">\n                    WARP6\n                </div>\n                <div class=\"text-[10.5px] text-[#52677C]\" data-kid=\"2-1-1-2-2\" data-name=\"Company legal name text\">\n                    Solutions S.R.L.\n                </div>\n            </div>\n        </div>\n        <nav class=\"py-3 flex-1\" data-kid=\"2-1-2\" data-name=\"Main navigation menu\">\n            <a class=\"relative flex items-center gap-3 px-4 py-2.5 text-[13.5px] text-[#52677C]\" data-kid=\"2-1-2-1\" data-name=\"Dashboard navigation link\">\n                <i class=\"ti ti-layout-dashboard text-[17px] w-5 text-center\" data-kid=\"2-1-2-1-1\" data-name=\"Dashboard icon\">\n                </i>\n                Inicio\n            </a>\n            <a class=\"relative flex items-center gap-3 px-4 py-2.5 text-[13.5px] text-[#52677C]\" data-kid=\"2-1-2-2\" data-name=\"Movements navigation link\">\n                <i class=\"ti ti-list-plus text-[17px] w-5 text-center\" data-kid=\"2-1-2-2-1\" data-name=\"Movements icon\">\n                </i>\n                Movimientos\n            </a>\n            <a class=\"relative flex items-center gap-3 px-4 py-2.5 text-[13.5px] font-medium text-[#2B68E8] bg-[#2B68E8]/[0.06]\" data-kid=\"2-1-2-3\" data-name=\"Reports navigation link\">\n                <span class=\"absolute left-0 inset-y-[5px] w-[3px] rounded-r-[2px] bg-[#2B68E8]\" data-kid=\"2-1-2-3-1\" data-name=\"Active link indicator bar\">\n                </span>\n                <i class=\"ti ti-file-chart-column text-[17px] w-5 text-center\" data-kid=\"2-1-2-3-2\" data-name=\"Reports icon\">\n                </i>\n                Reportes\n            </a>\n            <a class=\"relative flex items-center gap-3 px-4 py-2.5 text-[13.5px] text-[#52677C]\" data-kid=\"2-1-2-4\" data-name=\"Assets navigation link\">\n                <i class=\"ti ti-computer text-[17px] w-5 text-center\" data-kid=\"2-1-2-4-1\" data-name=\"Assets icon\">\n                </i>\n                Activos\n            </a>\n            <a class=\"relative flex items-center gap-3 px-4 py-2.5 text-[13.5px] text-[#52677C]\" data-kid=\"2-1-2-5\" data-name=\"Import navigation link\">\n                <i class=\"ti ti-file-up text-[17px] w-5 text-center\" data-kid=\"2-1-2-5-1\" data-name=\"Import icon\">\n                </i>\n                Importar\n            </a>\n        </nav>\n        <div class=\"px-5 py-4 border-t border-[#D7E2EC]\" data-kid=\"2-1-3\" data-name=\"Sidebar legal information container\">\n            <div class=\"text-[10.5px] text-[#52677C] leading-relaxed\" data-kid=\"2-1-3-1\" data-name=\"Legal information text\">\n                Ley 843 · DS 24051\n                <br data-kid=\"2-1-3-1-1\" data-name=\"Line break\"/>\n                Sistema Contable v2.0\n            </div>\n        </div>\n    </aside>\n    <!-- ===== Main ===== -->\n    <main class=\"ml-[228px] px-8 pt-6 pb-12\" data-kid=\"2-2\" data-name=\"Main content area\">\n        <!-- 1. Header -->\n        <div class=\"flex items-center justify-between\" data-kid=\"2-2-1\" data-name=\"Page header section\">\n            <h1 class=\"text-[22px] font-semibold tracking-tight\" data-kid=\"2-2-1-1\" data-name=\"Page title headline\">\n                Reportes\n            </h1>\n            <div class=\"flex items-center gap-2 bg-white border border-[#D7E2EC] rounded-[7px] px-3.5 py-2 text-[13px]\" data-kid=\"2-2-1-2\" data-name=\"Date range selector\">\n                <i class=\"ti ti-calendar-range text-[15px] text-[#52677C]\" data-kid=\"2-2-1-2-1\" data-name=\"Calendar icon\">\n                </i>\n                <span class=\"text-[#17324D]\" data-kid=\"2-2-1-2-2\" data-name=\"Date range display text\">\n                    Del 01/01/2026 al 31/08/2026\n                </span>\n                <i class=\"ti ti-chevron-down text-[14px] text-[#52677C]\" data-kid=\"2-2-1-2-3\" data-name=\"Dropdown chevron icon\">\n                </i>\n            </div>\n        </div>\n        <!-- 2. Parameters band -->\n        <div class=\"mt-4 bg-white border border-[#D7E2EC] rounded-[10px] px-5 py-3.5 flex items-center gap-6\" data-kid=\"2-2-2\" data-name=\"Parameters information band\">\n            <div class=\"flex items-center gap-2.5\" data-kid=\"2-2-2-1\" data-name=\"Initial UFV parameter container\">\n                <span class=\"text-[10.5px] font-medium uppercase tracking-[0.06em] text-[#52677C]\" data-kid=\"2-2-2-1-1\" data-name=\"Initial UFV parameter label\">\n                    UFV inicial\n                </span>\n                <div class=\"w-[96px] border border-[#D7E2EC] rounded-[6px] bg-[#F4F8FC]/70 px-2.5 py-1.5 text-[13px] fig\" data-kid=\"2-2-2-1-2\" data-name=\"Initial UFV value\">\n                    2.45000\n                </div>\n            </div>\n            <div class=\"flex items-center gap-2.5\" data-kid=\"2-2-2-2\" data-name=\"Final UFV parameter container\">\n                <span class=\"text-[10.5px] font-medium uppercase tracking-[0.06em] text-[#52677C]\" data-kid=\"2-2-2-2-1\" data-name=\"Final UFV parameter label\">\n                    UFV final\n                </span>\n                <div class=\"w-[96px] border border-[#D7E2EC] rounded-[6px] bg-[#F4F8FC]/70 px-2.5 py-1.5 text-[13px] fig\" data-kid=\"2-2-2-2-2\" data-name=\"Final UFV value\">\n                    2.51840\n                </div>\n            </div>\n            <div class=\"h-7 w-px bg-[#D7E2EC]\" data-kid=\"2-2-2-3\" data-name=\"Vertical separator\">\n            </div>\n            <div class=\"text-[13px] text-[#52677C]\" data-kid=\"2-2-2-4\" data-name=\"UFV variation information container\">\n                Variación UFV:\n                <span class=\"fig font-medium text-[#16735A]\" data-kid=\"2-2-2-4-1\" data-name=\"UFV variation percentage value\">\n                    +2,80%\n                </span>\n            </div>\n            <div class=\"ml-auto flex items-center gap-2.5\" data-kid=\"2-2-2-5\" data-name=\"External expenses toggle container\">\n                <span class=\"text-[13px]\" data-kid=\"2-2-2-5-1\" data-name=\"External expenses toggle label\">\n                    Excluir gastos externos\n                </span>\n                <span class=\"relative inline-block w-9 h-5 rounded-full bg-[#D7E2EC]\" data-kid=\"2-2-2-5-2\" data-name=\"Toggle switch track\">\n                    <span class=\"absolute left-[3px] top-[3px] w-[14px] h-[14px] rounded-full bg-white border border-[#C9D8E5]\" data-kid=\"2-2-2-5-2-1\" data-name=\"Toggle switch handle\">\n                    </span>\n                </span>\n            </div>\n        </div>\n        <!-- 3. Tabs -->\n        <div class=\"mt-6 border-b border-[#D7E2EC] flex items-center gap-7\" data-kid=\"2-2-3\" data-name=\"Navigation tabs container\">\n            <button class=\"pb-2.5 -mb-px text-[13.5px] font-medium text-[#17324D] border-b-2 border-[#2B68E8]\" data-kid=\"2-2-3-1\" data-name=\"Financial summary tab button\">\n                Resumen financiero\n            </button>\n            <button class=\"pb-2.5 text-[13.5px] text-[#52677C]\" data-kid=\"2-2-3-2\" data-name=\"Explore movements tab button\">\n                Explorar movimientos\n            </button>\n        </div>\n        <!-- 4. Resultado del período -->\n        <div class=\"mt-5\" data-kid=\"2-2-4\" data-name=\"Period result section\">\n            <div class=\"flex items-baseline justify-between mb-2\" data-kid=\"2-2-4-1\" data-name=\"Period result header container\">\n                <h2 class=\"text-[14px] font-semibold tracking-tight\" data-kid=\"2-2-4-1-1\" data-name=\"Period result section title\">\n                    Resultado del período\n                </h2>\n                <span class=\"text-[11.5px] text-[#52677C]\" data-kid=\"2-2-4-1-2\" data-name=\"Period result metadata subtitle\">\n                    Base gerencial · retenciones incluidas\n                </span>\n            </div>\n            <div class=\"bg-white border border-[#D7E2EC] rounded-[10px] grid grid-cols-4 divide-x divide-[#D7E2EC]\" data-kid=\"2-2-4-2\" data-name=\"Period result statistics grid\">\n                <div class=\"px-5 py-4\" data-kid=\"2-2-4-2-1\" data-name=\"Net income metric container\">\n                    <div class=\"text-[10.5px] font-medium uppercase tracking-[0.06em] text-[#52677C]\" data-kid=\"2-2-4-2-1-1\" data-name=\"Net income label\">\n                        Ingresos netos\n                    </div>\n                    <div class=\"fig text-[19px] font-semibold mt-1.5\" data-kid=\"2-2-4-2-1-2\" data-name=\"Net income value\">\n                        Bs 160.515,00\n                    </div>\n                </div>\n                <div class=\"px-5 py-4\" data-kid=\"2-2-4-2-2\" data-name=\"Net costs metric container\">\n                    <div class=\"text-[10.5px] font-medium uppercase tracking-[0.06em] text-[#52677C]\" data-kid=\"2-2-4-2-2-1\" data-name=\"Net costs label\">\n                        Costos netos\n                    </div>\n                    <div class=\"fig text-[19px] font-semibold mt-1.5\" data-kid=\"2-2-4-2-2-2\" data-name=\"Net costs value\">\n                        Bs 73.741,60\n                    </div>\n                </div>\n                <div class=\"px-5 py-4\" data-kid=\"2-2-4-2-3\" data-name=\"IT tax metric container\">\n                    <div class=\"text-[10.5px] font-medium uppercase tracking-[0.06em] text-[#52677C]\" data-kid=\"2-2-4-2-3-1\" data-name=\"IT tax label\">\n                        IT del período\n                    </div>\n                    <div class=\"fig text-[19px] font-semibold mt-1.5\" data-kid=\"2-2-4-2-3-2\" data-name=\"IT tax value\">\n                        Bs 5.535,00\n                    </div>\n                </div>\n                <div class=\"px-5 py-4\" data-kid=\"2-2-4-2-4\" data-name=\"Real profit metric container\">\n                    <div class=\"text-[10.5px] font-medium uppercase tracking-[0.06em] text-[#52677C]\" data-kid=\"2-2-4-2-4-1\" data-name=\"Real profit label\">\n                        Utilidad real\n                    </div>\n                    <div class=\"fig text-[19px] font-semibold mt-1.5 text-[#16735A]\" data-kid=\"2-2-4-2-4-2\" data-name=\"Real profit value\">\n                        Bs 81.238,40\n                    </div>\n                </div>\n            </div>\n        </div>\n        <!-- 5. Documentos disponibles -->\n        <div class=\"mt-6\" data-kid=\"2-2-5\" data-name=\"Available documents section\">\n            <div class=\"flex items-baseline justify-between mb-2\" data-kid=\"2-2-5-1\" data-name=\"Available documents header container\">\n                <h2 class=\"text-[14px] font-semibold tracking-tight\" data-kid=\"2-2-5-1-1\" data-name=\"Available documents section title\">\n                    Documentos disponibles\n                </h2>\n                <span class=\"text-[11.5px] text-[#52677C]\" data-kid=\"2-2-5-1-2\" data-name=\"Available documents metadata subtitle\">\n                    Generados con el período y la UFV actuales\n                </span>\n            </div>\n            <div class=\"grid grid-cols-2 gap-5\" data-kid=\"2-2-5-2\" data-name=\"Documents grid container\">\n                <!-- Grupo SIN -->\n                <div class=\"bg-white border border-[#D7E2EC] rounded-[10px]\" data-kid=\"2-2-5-2-1\" data-name=\"SIN documents group container\">\n                    <div class=\"px-5 py-3 border-b border-[#D7E2EC] flex items-center gap-2\" data-kid=\"2-2-5-2-1-1\" data-name=\"SIN documents header\">\n                        <span class=\"w-1.5 h-1.5 rounded-full bg-[#2B68E8]\" data-kid=\"2-2-5-2-1-1-1\" data-name=\"SIN group indicator dot\">\n                        </span>\n                        <span class=\"text-[13px] font-semibold\" data-kid=\"2-2-5-2-1-1-2\" data-name=\"SIN group title\">\n                            Para presentar al SIN\n                        </span>\n                        <span class=\"ml-auto text-[11px] text-[#52677C]\" data-kid=\"2-2-5-2-1-1-3\" data-name=\"SIN group subtitle\">\n                            Solo operaciones facturadas\n                        </span>\n                    </div>\n                    <div class=\"divide-y divide-[#D7E2EC]/70\" data-kid=\"2-2-5-2-1-2\" data-name=\"SIN documents list\">\n                        <div class=\"flex items-center gap-3.5 px-5 py-3.5\" data-kid=\"2-2-5-2-1-2-1\" data-name=\"Document entry\">\n                            <i class=\"ti ti-file-text text-[18px] text-[#52677C] shrink-0\" data-kid=\"2-2-5-2-1-2-1-1\" data-name=\"Document icon\">\n                            </i>\n                            <div class=\"min-w-0\" data-kid=\"2-2-5-2-1-2-1-2\" data-name=\"Document details container\">\n                                <div class=\"text-[13.5px] font-medium truncate\" data-kid=\"2-2-5-2-1-2-1-2-1\" data-name=\"Document name text\">\n                                    Estado de Resultados (Legal)\n                                </div>\n                                <div class=\"text-[12px] text-[#52677C] truncate\" data-kid=\"2-2-5-2-1-2-1-2-2\" data-name=\"Document description text\">\n                                    Excluye gastos sin factura\n                                </div>\n                            </div>\n                            <button class=\"ml-auto shrink-0 flex items-center gap-1.5 border border-[#C9D8E5] rounded-[7px] px-3 py-1.5 text-[12px] font-medium text-[#2B68E8]\" data-kid=\"2-2-5-2-1-2-1-3\" data-name=\"Download document button\">\n                                <i class=\"ti ti-download text-[13px]\" data-kid=\"2-2-5-2-1-2-1-3-1\" data-name=\"Download icon\">\n                                </i>\n                                PDF\n                            </button>\n                        </div>\n                        <div class=\"flex items-center gap-3.5 px-5 py-3.5\" data-kid=\"2-2-5-2-1-2-2\" data-name=\"Document entry\">\n                            <i class=\"ti ti-file-text text-[18px] text-[#52677C] shrink-0\" data-kid=\"2-2-5-2-1-2-2-1\" data-name=\"Document icon\">\n                            </i>\n                            <div class=\"min-w-0\" data-kid=\"2-2-5-2-1-2-2-2\" data-name=\"Document details container\">\n                                <div class=\"text-[13.5px] font-medium truncate\" data-kid=\"2-2-5-2-1-2-2-2-1\" data-name=\"Document name text\">\n                                    Estado de Resultados Legal Detallado\n                                </div>\n                                <div class=\"text-[12px] text-[#52677C] truncate\" data-kid=\"2-2-5-2-1-2-2-2-2\" data-name=\"Document description text\">\n                                    Con desglose de ítems y depreciación\n                                </div>\n                            </div>\n                            <button class=\"ml-auto shrink-0 flex items-center gap-1.5 border border-[#C9D8E5] rounded-[7px] px-3 py-1.5 text-[12px] font-medium text-[#2B68E8]\" data-kid=\"2-2-5-2-1-2-2-3\" data-name=\"Download document button\">\n                                <i class=\"ti ti-download text-[13px]\" data-kid=\"2-2-5-2-1-2-2-3-1\" data-name=\"Download icon\">\n                                </i>\n                                PDF\n                            </button>\n                        </div>\n                        <div class=\"flex items-center gap-3.5 px-5 py-3.5\" data-kid=\"2-2-5-2-1-2-3\" data-name=\"Document entry\">\n                            <i class=\"ti ti-scale text-[18px] text-[#52677C] shrink-0\" data-kid=\"2-2-5-2-1-2-3-1\" data-name=\"Document icon\">\n                            </i>\n                            <div class=\"min-w-0\" data-kid=\"2-2-5-2-1-2-3-2\" data-name=\"Document details container\">\n                                <div class=\"text-[13.5px] font-medium truncate\" data-kid=\"2-2-5-2-1-2-3-2-1\" data-name=\"Document name text\">\n                                    Balance General Legal (SIN)\n                                </div>\n                                <div class=\"text-[12px] text-[#52677C] truncate\" data-kid=\"2-2-5-2-1-2-3-2-2\" data-name=\"Document description text\">\n                                    Vista fiscal acumulada al corte\n                                </div>\n                            </div>\n                            <button class=\"ml-auto shrink-0 flex items-center gap-1.5 border border-[#C9D8E5] rounded-[7px] px-3 py-1.5 text-[12px] font-medium text-[#2B68E8]\" data-kid=\"2-2-5-2-1-2-3-3\" data-name=\"Download document button\">\n                                <i class=\"ti ti-download text-[13px]\" data-kid=\"2-2-5-2-1-2-3-3-1\" data-name=\"Download icon\">\n                                </i>\n                                PDF\n                            </button>\n                        </div>\n                    </div>\n                </div>\n                <!-- Grupo interno -->\n                <div class=\"bg-white border border-[#D7E2EC] rounded-[10px]\" data-kid=\"2-2-5-2-2\" data-name=\"Internal management documents group container\">\n                    <div class=\"px-5 py-3 border-b border-[#D7E2EC] flex items-center gap-2\" data-kid=\"2-2-5-2-2-1\" data-name=\"Internal documents header\">\n                        <span class=\"w-1.5 h-1.5 rounded-full bg-[#16735A]\" data-kid=\"2-2-5-2-2-1-1\" data-name=\"Internal group indicator dot\">\n                        </span>\n                        <span class=\"text-[13px] font-semibold\" data-kid=\"2-2-5-2-2-1-2\" data-name=\"Internal group title\">\n                            Para gestión interna\n                        </span>\n                        <span class=\"ml-auto text-[11px] text-[#52677C]\" data-kid=\"2-2-5-2-2-1-3\" data-name=\"Internal group subtitle\">\n                            Refleja la realidad de caja\n                        </span>\n                    </div>\n                    <div class=\"divide-y divide-[#D7E2EC]/70\" data-kid=\"2-2-5-2-2-2\" data-name=\"Internal documents list\">\n                        <div class=\"flex items-center gap-3.5 px-5 py-3.5\" data-kid=\"2-2-5-2-2-2-1\" data-name=\"Document entry\">\n                            <i class=\"ti ti-file-analytics text-[18px] text-[#52677C] shrink-0\" data-kid=\"2-2-5-2-2-2-1-1\" data-name=\"Document icon\">\n                            </i>\n                            <div class=\"min-w-0\" data-kid=\"2-2-5-2-2-2-1-2\" data-name=\"Document details container\">\n                                <div class=\"text-[13.5px] font-medium truncate\" data-kid=\"2-2-5-2-2-2-1-2-1\" data-name=\"Document name text\">\n                                    Estado de Resultados Gerencial\n                                </div>\n                                <div class=\"text-[12px] text-[#52677C] truncate\" data-kid=\"2-2-5-2-2-2-1-2-2\" data-name=\"Document description text\">\n                                    Caja real, EBITDA y márgenes\n                                </div>\n                            </div>\n                            <button class=\"ml-auto shrink-0 flex items-center gap-1.5 border border-[#C9D8E5] rounded-[7px] px-3 py-1.5 text-[12px] font-medium text-[#2B68E8]\" data-kid=\"2-2-5-2-2-2-1-3\" data-name=\"Download document button\">\n                                <i class=\"ti ti-download text-[13px]\" data-kid=\"2-2-5-2-2-2-1-3-1\" data-name=\"Download icon\">\n                                </i>\n                                PDF\n                            </button>\n                        </div>\n                        <div class=\"flex items-center gap-3.5 px-5 py-3.5\" data-kid=\"2-2-5-2-2-2-2\" data-name=\"Document entry\">\n                            <i class=\"ti ti-scale text-[18px] text-[#52677C] shrink-0\" data-kid=\"2-2-5-2-2-2-2-1\" data-name=\"Document icon\">\n                            </i>\n                            <div class=\"min-w-0\" data-kid=\"2-2-5-2-2-2-2-2\" data-name=\"Document details container\">\n                                <div class=\"text-[13.5px] font-medium truncate\" data-kid=\"2-2-5-2-2-2-2-2-1\" data-name=\"Document name text\">\n                                    Balance General Gerencial (Real)\n                                </div>\n                                <div class=\"text-[12px] text-[#52677C] truncate\" data-kid=\"2-2-5-2-2-2-2-2-2\" data-name=\"Document description text\">\n                                    Incluye gastos no deducibles\n                                </div>\n                            </div>\n                            <button class=\"ml-auto shrink-0 flex items-center gap-1.5 border border-[#C9D8E5] rounded-[7px] px-3 py-1.5 text-[12px] font-medium text-[#2B68E8]\" data-kid=\"2-2-5-2-2-2-2-3\" data-name=\"Download document button\">\n                                <i class=\"ti ti-download text-[13px]\" data-kid=\"2-2-5-2-2-2-2-3-1\" data-name=\"Download icon\">\n                                </i>\n                                PDF\n                            </button>\n                        </div>\n                        <div class=\"flex items-center gap-3.5 px-5 py-3.5\" data-kid=\"2-2-5-2-2-2-3\" data-name=\"Document entry\">\n                            <i class=\"ti ti-clipboard-text text-[18px] text-[#52677C] shrink-0\" data-kid=\"2-2-5-2-2-2-3-1\" data-name=\"Document icon\">\n                            </i>\n                            <div class=\"min-w-0\" data-kid=\"2-2-5-2-2-2-3-2\" data-name=\"Document details container\">\n                                <div class=\"text-[13.5px] font-medium truncate\" data-kid=\"2-2-5-2-2-2-3-2-1\" data-name=\"Document name text\">\n                                    Informe Gerencial Completo\n                                </div>\n                                <div class=\"text-[12px] text-[#52677C] truncate\" data-kid=\"2-2-5-2-2-2-3-2-2\" data-name=\"Document description text\">\n                                    Resumen estratégico de 5 páginas\n                                </div>\n                            </div>\n                            <button class=\"ml-auto shrink-0 flex items-center gap-1.5 border border-[#C9D8E5] rounded-[7px] px-3 py-1.5 text-[12px] font-medium text-[#2B68E8]\" data-kid=\"2-2-5-2-2-2-3-3\" data-name=\"Download document button\">\n                                <i class=\"ti ti-download text-[13px]\" data-kid=\"2-2-5-2-2-2-3-3-1\" data-name=\"Download 