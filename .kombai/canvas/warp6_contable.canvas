o value\">\n                                3.224,00\n                            </td>\n                            <td class=\"text-right px-4\" data-kid=\"2-2-2-5-2-2-7-3\" data-name=\"IVA pagado value\">\n                                3.424,00\n                            </td>\n                            <td class=\"text-right px-4\" data-kid=\"2-2-2-5-2-2-7-4\" data-name=\"IT adeudado value\">\n                                744,00\n                            </td>\n                            <td class=\"text-right px-4\" data-kid=\"2-2-2-5-2-2-7-5\" data-name=\"IT pagado value\">\n                                744,00\n                            </td>\n                            <td class=\"text-right px-4 text-[#2B68E8]\" data-kid=\"2-2-2-5-2-2-7-6\" data-name=\"Diferencia value\">\n                                −200,00\n                            </td>\n                            <td class=\"px-4 pl-8 font-sans\" data-kid=\"2-2-2-5-2-2-7-7\" data-name=\"Status cell\">\n                                <span class=\"inline-flex items-center gap-2 text-[#2B68E8]\" data-kid=\"2-2-2-5-2-2-7-7-1\" data-name=\"Status label\">\n                                    <span class=\"w-1.5 h-1.5 rounded-full bg-[#2B68E8]\" data-kid=\"2-2-2-5-2-2-7-7-1-1\" data-name=\"Status indicator dot\">\n                                    </span>\n                                    Pago en exceso\n                                </span>\n                            </td>\n                        </tr>\n                        <tr class=\"border-b border-[#E5EDF4] h-[44px] bg-[#FFF1F0]\" data-kid=\"2-2-2-5-2-2-8\" data-name=\"August row\">\n                            <td class=\"px-4 font-sans font-medium text-[#8F2E28]\" data-kid=\"2-2-2-5-2-2-8-1\" data-name=\"Month name\">\n                                Agosto\n                            </td>\n                            <td class=\"text-right px-4\" data-kid=\"2-2-2-5-2-2-8-2\" data-name=\"IVA adeudado value\">\n                                3.432,00\n                            </td>\n                            <td class=\"text-right px-4\" data-kid=\"2-2-2-5-2-2-8-3\" data-name=\"IVA pagado value\">\n                                1.500,00\n                            </td>\n                            <td class=\"text-right px-4\" data-kid=\"2-2-2-5-2-2-8-4\" data-name=\"IT adeudado value\">\n                                792,00\n                            </td>\n                            <td class=\"text-right px-4\" data-kid=\"2-2-2-5-2-2-8-5\" data-name=\"IT pagado value\">\n                                384,00\n                            </td>\n                            <td class=\"text-right px-4 text-[#B5423C] font-semibold\" data-kid=\"2-2-2-5-2-2-8-6\" data-name=\"Diferencia value\">\n                                2.340,00\n                            </td>\n                            <td class=\"px-4 pl-8 font-sans\" data-kid=\"2-2-2-5-2-2-8-7\" data-name=\"Status cell\">\n                                <span class=\"inline-flex items-center gap-2 text-[#B5423C]\" data-kid=\"2-2-2-5-2-2-8-7-1\" data-name=\"Status label\">\n                                    <span class=\"w-1.5 h-1.5 rounded-full bg-[#B5423C]\" data-kid=\"2-2-2-5-2-2-8-7-1-1\" data-name=\"Status indicator dot\">\n                                    </span>\n                                    Pendiente\n                                </span>\n                            </td>\n                        </tr>\n                    </tbody>\n                </table>\n                <div class=\"text-[12px] text-[#52677C] mt-2\" data-kid=\"2-2-2-5-3\" data-name=\"Table info text\">\n                    Importes en bolivianos (Bs). Diferencia = determinado − pagado.\n                </div>\n            </section>\n            <div class=\"pt-2 text-[12px] text-[#52677C]\" data-kid=\"2-2-2-6\" data-name=\"Application version footer\">\n                Sistema Contable v1.2 · WARP6 Solutions S.R.L.\n            </div>\n        </div>\n    </main>\n</div>\n<script>\n    const fmtInt = n => n.toLocaleString('de-DE');\n  Chart.defaults.font.family = \"'Inter', sans-serif\";\n  Chart.defaults.color = '#52677C';\n\n  // ---- Gastos por categoría (barras horizontales + etiquetas de valor) ----\n  const barLabels = {\n    id: 'barLabels',\n    afterDatasetsDraw(chart) {\n      const ctx = chart.ctx;\n      const meta = chart.getDatasetMeta(0);\n      ctx.save();\n      ctx.font = \"500 11px 'IBM Plex Mono', monospace\";\n      ctx.fillStyle = '#52677C';\n      ctx.textAlign = 'left';\n      ctx.textBaseline = 'middle';\n      meta.data.forEach((bar, i) => {\n        const v = chart.data.datasets[0].data[i];\n        ctx.fillText('Bs ' + fmtInt(v), bar.x + 8, bar.y);\n      });\n      ctx.restore();\n    }\n  };\n  new Chart(document.getElementById('chartCategorias'), {\n    type: 'bar',\n    plugins: [barLabels],\n    data: {\n      labels: ['Materiales', 'Sueldos', 'Alquiler', 'Serv. Básicos', 'Transporte', 'Refrigerio'],\n      datasets: [{\n        data: [34120, 28500, 9600, 7340, 5280, 2400],\n        backgroundColor: ['#2B68E8', '#4A7EEC', '#6A95F0', '#8BAEFE', '#A9C5FE', '#C4D8FE'],\n        borderRadius: 2,\n        barThickness: 16\n      }]\n    },\n    options: {\n      indexAxis: 'y',\n      responsive: true,\n      maintainAspectRatio: false,\n      layout: { padding: { right: 64 } },\n      plugins: {\n        legend: { display: false },\n        tooltip: {\n          backgroundColor: '#17324D', padding: 10, cornerRadius: 6, displayColors: false,\n          callbacks: { label: c => 'Bs ' + c.parsed.x.toLocaleString('de-DE', {minimumFractionDigits: 2}) }\n        }\n      },\n      scales: {\n        x: { suggestedMax: 42000, grid: { color: '#EDF2F7' }, border: { display: false }, ticks: { callback: v => (v/1000) + 'k', font: { size: 11 } } },\n        y: { grid: { display: false }, border: { display: false }, ticks: { font: { size: 12, weight: 500 }, color: '#17324D' } }\n      }\n    }\n  });\n\n  // ---- Ingresos y gastos por mes (áreas, segmentos rectos) ----\n  new Chart(document.getElementById('chartTiempo'), {\n    type: 'line',\n    data: {\n      labels: ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep'],\n      datasets: [\n        {\n          label: 'Ingresos',\n          data: [12800, 16400, 19200, 15800, 22400, 20100, 24800, 26400, 26600],\n          borderColor: '#2B68E8', backgroundColor: 'rgba(43,104,232,0.12)',\n          fill: true, tension: 0, borderWidth: 2, pointRadius: 0, pointHoverRadius: 4, pointHoverBackgroundColor: '#2B68E8'\n        },\n        {\n          label: 'Gastos',\n          data: [8200, 9400, 11800, 8600, 12400, 10200, 13800, 11240, 11600],\n          borderColor: '#64748B', backgroundColor: 'rgba(100,116,139,0.10)',\n          fill: true, tension: 0, borderWidth: 2, pointRadius: 0, pointHoverRadius: 4, pointHoverBackgroundColor: '#64748B'\n        }\n      ]\n    },\n    options: {\n      responsive: true,\n      maintainAspectRatio: false,\n      interaction: { mode: 'index', intersect: false },\n      plugins: {\n        legend: { display: false },\n        tooltip: {\n          backgroundColor: '#17324D', padding: 10, cornerRadius: 6,\n          callbacks: { label: c => c.dataset.label + ': Bs ' + c.parsed.y.toLocaleString('de-DE', {minimumFractionDigits: 2}) }\n        }\n      },\n      scales: {\n        x: { grid: { display: false }, border: { color: '#D7E2EC' }, ticks: { font: { size: 11 } } },\n        y: { grid: { color: '#EDF2F7' }, border: { display: false }, ticks: { callback: v => 'Bs ' + (v/1000) + 'k', font: { size: 11 } } }\n      }\n    }\n  });\n</script>\n",
