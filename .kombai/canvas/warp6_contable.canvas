      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap');\n</style>\n<link data-kid=\"1\" data-name=\"Tabler icon library stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<script src=\"https://cdn.jsdelivr.net/npm/chart.js\">\n</script>\n<div class=\"flex min-h-screen bg-[#F4F8FC] text-[#17324D] font-['Inter'] antialiased\" data-kid=\"2\" data-name=\"Application dashboard container\">\n    <!-- ============ NAV RAIL ============ -->\n    <aside class=\"w-[228px] shrink-0 bg-white border-r border-[#D7E2EC] flex flex-col\" data-kid=\"2-1\" data-name=\"Left side navigation rail\">\n        <div class=\"px-5 pt-6 pb-5\" data-kid=\"2-1-1\" data-name=\"Brand info area\">\n            <div class=\"text-[18px] font-bold tracking-tight text-[#17324D]\" data-kid=\"2-1-1-1\" data-name=\"Application name heading\">\n                WARP6\n            </div>\n            <div class=\"text-[11px] font-medium text-[#52677C] mt-0.5\" data-kid=\"2-1-1-2\" data-name=\"Organization name text\">\n                Solutions S.R.L.\n            </div>\n        </div>\n        <nav class=\"flex-1\" data-kid=\"2-1-2\" data-name=\"Navigation menu links\">\n            <a class=\"relative flex items-center gap-3 h-10 px-5 text-[14px] font-semibold text-[#1D4FBF] bg-[#2B68E8]/[0.07]\" data-kid=\"2-1-2-1\" data-name=\"Active navigation link\" href=\"#\">\n                <span class=\"absolute left-0 top-0 h-full w-[3px] bg-[#2B68E8]\" data-kid=\"2-1-2-1-1\" data-name=\"Active link highlight bar\">\n                </span>\n                <i class=\"ti ti-layout-dashboard text-[18px]\" data-kid=\"2-1-2-1-2\" data-name=\"Dashboard icon\">\n                </i>\n                Inicio\n            </a>\n            <a class=\"flex items-center gap-3 h-10 px-5 text-[14px] font-medium text-[#52677C] hover:bg-[#F4F8FC]\" data-kid=\"2-1-2-2\" data-name=\"Movements navigation link\" href=\"#\">\n                <i class=\"ti ti-list-plus text-[18px]\" data-kid=\"2-1-2-2-1\" data-name=\"Movements icon\">\n                </i>\n                Movimientos\n            </a>\n            <a class=\"flex items-center gap-3 h-10 px-5 text-[14px] font-medium text-[#52677C] hover:bg-[#F4F8FC]\" data-kid=\"2-1-2-3\" data-name=\"Reports navigation link\" href=\"#\">\n                <i class=\"ti ti-file-chart-column text-[18px]\" data-kid=\"2-1-2-3-1\" data-name=\"Reports icon\">\n                </i>\n                Reportes\n            </a>\n            <a class=\"flex items-center gap-3 h-10 px-5 text-[14px] font-medium text-[#52677C] hover:bg-[#F4F8FC]\" data-kid=\"2-1-2-4\" data-name=\"Assets navigation link\" href=\"#\">\n                <i class=\"ti ti-computer text-[18px]\" data-kid=\"2-1-2-4-1\" data-name=\"Assets icon\">\n                </i>\n                Activos\n            </a>\n            <a class=\"flex items-center gap-3 h-10 px-5 text-[14px] font-medium text-[#52677C] hover:bg-[#F4F8FC]\" data-kid=\"2-1-2-5\" data-name=\"Import navigation link\" href=\"#\">\n                <i class=\"ti ti-file-up text-[18px]\" data-kid=\"2-1-2-5-1\" data-name=\"Import icon\">\n                </i>\n                Importar\n            </a>\n            <div class=\"mx-5 my-4 border-t border-[#D7E2EC]\" data-kid=\"2-1-2-6\" data-name=\"Divider line\">\n            </div>\n            <div class=\"px-5 text-[11px] font-medium text-[#52677C] leading-relaxed\" data-kid=\"2-1-2-7\" data-name=\"Normative info text\">\n                Ley 843 · DS 24051\n                <br data-kid=\"2-1-2-7-1\" data-name=\"Line break element\"/>\n                Normativa vigente\n            </div>\n        </nav>\n        <div class=\"px-5 py-4 border-t border-[#D7E2EC]\" data-kid=\"2-1-3\" data-name=\"User profile container\">\n            <div class=\"flex items-center gap-2.5\" data-kid=\"2-1-3-1\" data-name=\"User profile info\">\n                <span class=\"w-7 h-7 rounded-full bg-[#2B68E8]/10 text-[#1D4FBF] flex items-center justify-center text-[11px] font-bold\" data-kid=\"2-1-3-1-1\" data-name=\"User avatar placeholder\">\n                    WS\n                </span>\n                <div class=\"min-w-0\" data-kid=\"2-1-3-1-2\" data-name=\"User details\">\n                    <div class=\"text-[12px] font-semibold text-[#17324D] truncate\" data-kid=\"2-1-3-1-2-1\" data-name=\"User role\">\n                        Administrador\n                    </div>\n                    <div class=\"text-[11px] text-[#52677C] truncate\" data-kid=\"2-1-3-1-2-2\" data-name=\"Session status\">\n                        Sesión activa\n                    </div>\n                </div>\n            </div>\n        </div>\n    </aside>\n    <!-- ============ MAIN ============ -->\n    <main class=\"flex-1 min-w-0\" data-kid=\"2-2\" data-name=\"Main content area\">\n        <!-- Header row -->\n        <div class=\"h-16 flex items-center justify-between px-8 border-b border-[#D7E2EC] bg-[#F4F8FC]\" data-kid=\"2-2-1\" data-name=\"Header row\">\n            <h1 class=\"text-[22px] font-bold tracking-tight\" data-kid=\"2-2-1-1\" data-name=\"Page title heading\">\n                Inicio\n            </h1>\n            <div class=\"flex items-center gap-3\" data-kid=\"2-2-1-2\" data-name=\"Filter controls container\">\n                <button class=\"flex items-center gap-2 h-9 px-3 bg-white border border-[#D7E2EC] rounded-[6px] text-[13px] font-medium\" data-kid=\"2-2-1-2-1\" data-name=\"Date range picker button\">\n                    <i class=\"ti ti-calendar-range text-[16px] text-[#52677C]\" data-kid=\"2-2-1-2-1-1\" data-name=\"Calendar icon\">\n                    </i>\n                    <span class=\"font-['IBM_Plex_Mono'] text-[12.5px]\" data-kid=\"2-2-1-2-1-2\" data-name=\"Selected date range text\">\n                        01/01/2026 – 12/09/2026\n                    </span>\n                    <i class=\"ti ti-chevron-down text-[14px] text-[#52677C]\" data-kid=\"2-2-1-2-1-3\" data-name=\"Chevron down icon\">\n                    </i>\n                </button>\n                <button class=\"flex items-center gap-2 h-9 px-3 bg-white border border-[#D7E2EC] rounded-[6px] text-[13px] font-medium\" data-kid=\"2-2-1-2-2\" data-name=\"Project selector button\">\n                    <i class=\"ti ti-building-factory-2 text-[16px] text-[#52677C]\" data-kid=\"2-2-1-2-2-1\" data-name=\"Building factory icon\">\n                    </i>\n                    Todos los proyectos\n                    <i class=\"ti ti-chevron-down text-[14px] text-[#52677C]\" data-kid=\"2-2-1-2-2-2\" data-name=\"Chevron down icon\">\n                    </i>\n                </button>\n                <div class=\"flex items-center gap-2 h-9 px-3 text-[13px] font-medium text-[#52677C] select-none\" data-kid=\"2-2-1-2-3\" data-name=\"Filter toggle switch\">\n                    <span class=\"relative w-9 h-5 rounded-full bg-[#D7E2EC]\" data-kid=\"2-2-1-2-3-1\" data-name=\"Toggle rail\">\n                        <span class=\"absolute top-0.5 left-0.5 w-4 h-4 rounded-full bg-white\" data-kid=\"2-2-1-2-3-1-1\" data-name=\"Toggle handle\">\n                        </span>\n                    </span>\n                    Excluir gastos externos\n                </div>\n                <a class=\"text-[13px] font-semibold text-[#2B68E8] hover:text-[#2057CB]\" data-kid=\"2-2-1-2-4\" data-name=\"Reset filters link\" href=\"#\">\n                    Restablecer filtros\n                </a>\n            </div>\n        </div>\n        <div class=\"px-8 pt-6 pb-10 space-y-6\" data-kid=\"2-2-2\" data-name=\"Content section container\">\n            <!-- Alerta fiscal -->\n            <div class=\"flex items-center gap-4 bg-[#FFF1F0] border border-[#EAC5C2] rounded-[10px] px-5 py-4\" data-kid=\"2-2-2-1\" data-name=\"Fiscal alert box\">\n                <i class=\"ti ti-triangle-alert text-[22px] text-[#B5423C] shrink-0\" data-kid=\"2-2-2-1-1\" data-name=\"Warning triangle icon\">\n                </i>\n                <div class=\"min-w-0\" data-kid=\"2-2-2-1-2\" data-name=\"Alert text content\">\n                    <div class=\"text-[14px] font-semibold text-[#8F2E28]\" data-kid=\"2-2-2-1-2-1\" data-name=\"Alert title\">\n                        Pendiente fiscal en agosto:\n                        <span class=\"font-['IBM_Plex_Mono'] font-semibold\" data-kid=\"2-2-2-1-2-1-1\" data-name=\"Pending fiscal amount\">\n                            Bs 2.340,00\n                        </span>\n                    </div>\n                    <div class=\"text-[12.5px] text-[#9A5B55] mt-0.5\" data-kid=\"2-2-2-1-2-2\" data-name=\"Alert sub-description\">\n                        IVA e IT determinados superan los pagos registrados.\n                    </div>\n                </div>\n                <a class=\"ml-auto shrink-0 flex items-center gap-1.5 text-[13px] font-semibold text-[#B5423C] hover:text-[#8F2E28]\" data-kid=\"2-2-2-1-3\" data-name=\"Calendar fiscal link\" href=\"#\">\n                    Ver calendario fiscal\n                    <i class=\"ti ti-arrow-narrow-right text-[15px]\" data-kid=\"2-2-2-1-3-1\" data-name=\"Arrow icon\">\n                    </i>\n                </a>\n            </div>\n            <!-- KPIs -->\n            <section data-kid=\"2-2-2-2\" data-name=\"KPIs section\">\n                <h2 class=\"text-[15px] font-semibold mb-3\" data-kid=\"2-2-2-2-1\" data-name=\"Section heading\">\n                    Resumen operativo y fiscal\n                </h2>\n                <div class=\"grid grid-cols-5 bg-white border border-[#D7E2EC] rounded-[10px] divide-x divide-[#E5EDF4]\" data-kid=\"2-2-2-2-2\" data-name=\"KPIs grid container\">\n                    <div class=\"col-span-2 relative overflow-hidden px-6 pt-5 pb-12\" data-kid=\"2-2-2-2-2-1\" data-name=\"Sales KPI card\">\n                        <div class=\"text-[13px] font-medium text-[#52677C]\" data-kid=\"2-2-2-2-2-1-1\" data-name=\"Sales label\">\n                            Ventas\n                        </div>\n                        <div class=\"mt-1 text-[28px] font-semibold font-['IBM_Plex_Mono'] tabular-nums tracking-tight\" data-kid=\"2-2-2-2-2-1-2\" data-name=\"Sales total amount\">\n                            Bs 184.500,00\n                        </div>\n                        <div class=\"mt-1 text-[12px] text-[#52677C]\" data-kid=\"2-2-2-2-2-1-3\" data-name=\"Sales contributions text\">\n                            Aportes registrados:\n                            <span class=\"font-['IBM_Plex_Mono']\" data-kid=\"2-2-2-2-2-1-3-1\" data-name=\"Sales contribution amount\">\n                                Bs 50.000,00\n                            </span>\n                        </div>\n                        <svg class=\"absolute bottom-0 inset-x-0 w-full h-[44px] pointer-events-none\" data-kid=\"2-2-2-2-2-1-4\" data-name=\"Sales trend chart svg\" preserveaspectratio=\"none\" viewbox=\"0 0 460 44\">\n                            <path d=\"M0,38 L42,34 L84,36 L126,29 L168,31 L210,24 L252,26 L294,19 L336,21 L378,13 L420,15 L460,6 L460,44 L0,44 Z\" fill=\"rgba(43,104,232,0.06)\">\n                            </path>\n                            <path d=\"M0,38 L42,34 L84,36 L126,29 L168,31 L210,24 L252,26 L294,19 L336,21 L378,13 L420,15 L460,6\" fill=\"none\" stroke=\"rgba(43,104,232,0.35)\" stroke-width=\"1.5\">\n                            </path>\n                        </svg>\n                    </div>\n                    <div class=\"px-6 py-5\" data-kid=\"2-2-2-2-2-2\" data-name=\"Expenses KPI card\">\n                        <div class=\"text-[13px] font-medium text-[#52677C]\" data-kid=\"2-2-2-2-2-2-1\" data-name=\"Expenses label\">\n                            Gastos\n                        </div>\n                        <div class=\"mt-1 text-[24px] font-semibold font-['IBM_Plex_Mono'] tabular-nums tracking-tight\" data-kid=\"2-2-2-2-2-2-2\" data-name=\"Expenses total amount\">\n                            Bs 97.240,00\n                        </div>\n                        <div class=\"mt-1 text-[12px] text-[#52677C]\" data-kid=\"2-2-2-2-2-2-3\" data-name=\"Expenses count text\">\n                            86 movimientos\n                        </div>\n                    </div>\n                    <div class=\"px-6 py-5\" data-kid=\"2-2-2-2-2-3\" data-name=\"IVA generated KPI card\">\n                        <div class=\"text-[13px] font-medium text-[#52677C]\" data-kid=\"2-2-2-2-2-3-1\" data-name=\"IVA generated label\">\n                            IVA generado (13%)\n                        </div>\n                        <div class=\"mt-1 text-[24px] font-semibold font-['IBM_Plex_Mono'] tabular-nums tracking-tight\" data-kid=\"2-2-2-2-2-3-2\" data-name=\"IVA generated amount\">\n                            Bs 23.985,00\n                        </div>\n                        <div class=\"mt-1 text-[12px] text-[#52677C]\" data-kid=\"2-2-2-2-2-3-3\" data-name=\"IVA description text\">\n                            Débito fiscal del período\n                        </div>\n                    </div>\n                    <div class=\"px-6 py-5\" data-kid=\"2-2-2-2-2-4\" data-name=\"IT paid KPI card\">\n                        <div class=\"text-[13px] font-medium text-[#52677C]\" data-kid=\"2-2-2-2-2-4-1\" data-name=\"IT paid label\">\n                            IT pagado\n                        </div>\n                        <div class=\"mt-1 text-[24px] font-semibold font-['IBM_Plex_Mono'] tabular-nums tracking-tight\" data-kid=\"2-2-2-2-2-4-2\" data-name=\"IT paid amount\">\n                            Bs 5.535,00\n                        </div>\n                        <div class=\"mt-1 text-[12px] text-[#16735A] flex items-center gap-1\" data-kid=\"2-2-2-2-2-4-3\" data-name=\"IT status text\">\n                            <i class=\"ti ti-badge-check text-[13px]\" data-kid=\"2-2-2-2-2-4-3-1\" data-name=\"Status checkmark icon\">\n                            </i>\n                            Form. 400 al día (ene–jul)\n                        </div>\n                    </div>\n                </div>\n            </section>\n            <!-- Zona de excepción -->\n            <section class=\"grid grid-cols-2 gap-6\" data-kid=\"2-2-2-3\" data-name=\"Exception section container\">\n                <div class=\"bg-white border border-[#D7E2EC] rounded-[10px] px-6 py-5 flex flex-col gap-1\" data-kid=\"2-2-2-3-1\" data-name=\"Non-invoiced expenses card\">\n                    <div class=\"flex items-center gap-2 text-[14px] font-semibold\" data-kid=\"2-2-2-3-1-1\" data-name=\"Non-invoiced expenses header\">\n                        <span class=\"w-2 h-2 rounded-full bg-[#B86B13]\" data-kid=\"2-2-2-3-1-1-1\" data-name=\"Status indicator dot\">\n                        </span>\n                        Gastos sin factura\n                    </div>\n                    <div class=\"text-[24px] font-semibold font-['IBM_Plex_Mono'] tabular-nums text-[#B86B13] mt-1\" data-kid=\"2-2-2-3-1-2\" data-name=\"Non-invoiced expenses amount\">\n                        Bs 12.480,00\n                    </div>\n                    <div class=\"text-[12.5px] text-[#52677C]\" data-kid=\"2-2-2-3-1-3\" data-name=\"Non-invoiced description\">\n                        14 movimientos afectados · No reducen la base imponible\n                    </div>\n                    <a class=\"mt-2 text-[13px] font-semibold text-[#2B68E8] hover:text-[#2057CB] inline-flex items-center gap-1.5\" data-kid=\"2-2-2-3-1-4\" data-name=\"Review link\" href=\"#\">\n                        Revisar movimientos\n                        <i class=\"ti ti-arrow-narrow-right text-[14px]\" data-kid=\"2-2-2-3-1-4-1\" data-name=\"Arrow icon\">\n                        </i>\n                    </a>\n                </div>\n                <div class=\"bg-white border border-[#D7E2EC] rounded-[10px] px-6 py-5 flex flex-col gap-1\" data-kid=\"2-2-2-3-2\" data-name=\"Lost tax credit card\">\n                    <div class=\"flex items-center gap-2 text-[14px] font-semibold\" data-kid=\"2-2-2-3-2-1\" data-name=\"Lost tax credit header\">\n                        <span class=\"w-2 h-2 rounded-full bg-[#B5423C]\" data-kid=\"2-2-2-3-2-1-1\" data-name=\"Status indicator dot\">\n                        </span>\n                        Crédito fiscal perdido\n                    </div>\n                    <div class=\"text-[24px] font-semibold font-['IBM_Plex_Mono'] tabular-nums text-[#B5423C] mt-1\" data-kid=\"2-2-2-3-2-2\" data-name=\"Lost tax credit amount\">\n                        Bs 1.622,40\n                    </div>\n                    <div class=\"text-[12.5px] text-[#52677C]\" data-kid=\"2-2-2-3-2-3\" data-name=\"Lost tax credit description\">\n                        13% sobre Bs 12.480,00 sin respaldo · IVA no aprovechable\n                    </div>\n                    <a class=\"mt-2 text-[13px] font-semibold text-[#2B68E8] hover:text-[#2057CB] inline-flex items-center gap-1.5\" data-kid=\"2-2-2-3-2-4\" data-name=\"Review link\" href=\"#\">\n                        Revisar movimientos\n                        <i class=\"ti ti-arrow-narrow-right text-[14px]\" data-kid=\"2-2-2-3-2-4-1\" data-name=\"Arrow icon\">\n                        </i>\n                    </a>\n                </div>\n            </section>\n            <!-- Gráficos -->\n            <section class=\"grid grid-cols-12 gap-6\" data-kid=\"2-2-2-4\" data-name=\"Charts section container\">\n                <div class=\"col-span-5 bg-white border border-[#D7E2EC] rounded-[10px] px-6 py-5\" data-kid=\"2-2-2-4-1\" data-name=\"Category expenses chart card\">\n                    <div class=\"flex items-center justify-between mb-4\" data-kid=\"2-2-2-4-1-1\" data-name=\"Chart card header\">\n                        <h3 class=\"text-[14px] font-semibold\" data-kid=\"2-2-2-4-1-1-1\" data-name=\"Chart title\">\n                            Gastos por categoría\n                        </h3>\n                        <a class=\"text-[12.5px] font-semibold text-[#2B68E8]\" data-kid=\"2-2-2-4-1-1-2\" data-name=\"See all categories link\" href=\"#\">\n                            Ver todas\n                        </a>\n                    </div>\n                    <div class=\"h-[300px]\" data-kid=\"2-2-2-4-1-2\" data-name=\"Chart canvas container\">\n                        <canvas data-dynamic=\"true\" data-kid=\"2-2-2-4-1-2-1\" data-name=\"Categories chart canvas\" data-reason=\"rendered and managed by Chart.js\" id=\"chartCategorias\">\n                        </canvas>\n                    </div>\n                </div>\n                <div class=\"col-span-7 bg-white border border-[#D7E2EC] rounded-[10px] px-6 py-5\" data-kid=\"2-2-2-4-2\" data-name=\"Time-series chart card\">\n                    <div class=\"flex items-center justify-between mb-4\" data-kid=\"2-2-2-4-2-1\" data-name=\"Chart card header\">\n                        <h3 class=\"text-[14px] font-semibold\" data-kid=\"2-2-2-4-2-1-1\" data-name=\"Chart title\">\n                            Ingresos y gastos por mes\n                        </h3>\n                        <div class=\"flex items-center gap-4 text-[12px] font-medium text-[#52677C]\" data-kid=\"2-2-2-4-2-1-2\" data-name=\"Chart legend\">\n                            <span class=\"flex items-center gap-1.5\" data-kid=\"2-2-2-4-2-1-2-1\" data-name=\"Ingresos legend label\">\n                                <span class=\"w-2.5 h-2.5 rounded-sm bg-[#2B68E8]\" data-kid=\"2-2-2-4-2-1-2-1-1\" data-name=\"Ingresos color indicator\">\n                                </span>\n                                Ingresos\n                            </span>\n                            <span class=\"flex items-center gap-1.5\" data-kid=\"2-2-2-4-2-1-2-2\" data-name=\"Gastos legend label\">\n                                <span class=\"w-2.5 h-2.5 rounded-sm bg-[#64748B]\" data-kid=\"2-2-2-4-2-1-2-2-1\" data-name=\"Gastos color indicator\">\n                                </span>\n                                Gastos\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"h-[300px]\" data-kid=\"2-2-2-4-2-2\" data-name=\"Chart canvas container\">\n                        <canvas data-dynamic=\"true\" data-kid=\"2-2-2-4-2-2-1\" data-name=\"Time-series chart canvas\" data-reason=\"rendered and managed by Chart.js\" id=\"chartTiempo\">\n                        </canvas>\n                    </div>\n                </div>\n            </section>\n            <!-- Calendario fiscal -->\n            <section data-kid=\"2-2-2-5\" data-name=\"Fiscal calendar section\">\n                <div class=\"flex items-baseline justify-between mb-3\" data-kid=\"2-2-2-5-1\" data-name=\"Calendar header area\">\n                    <div data-kid=\"2-2-2-5-1-1\" data-name=\"Calendar title area\">\n                        <h2 class=\"text-[15px] font-semibold\" data-kid=\"2-2-2-5-1-1-1\" data-name=\"Section title\">\n                            Calendario fiscal\n                        </h2>\n                        <p class=\"text-[12.5px] text-[#52677C] mt-0.5\" data-kid=\"2-2-2-5-1-1-2\" data-name=\"Section description\">\n                            Impuesto determinado y pagos registrados por mes.\n                        </p>\n                    </div>\n                    <a class=\"text-[12.5px] font-semibold text-[#2B68E8]\" data-kid=\"2-2-2-5-1-2\" data-name=\"Export link\" href=\"#\">\n                        Exportar detalle\n                    </a>\n                </div>\n                <table class=\"w-full text-[13px] border-collapse\" data-kid=\"2-2-2-5-2\" data-name=\"Fiscal calendar table\">\n                    <thead data-kid=\"2-2-2-5-2-1\" data-name=\"Table header\">\n                        <tr class=\"border-y border-[#D7E2EC] text-[#52677C] font-medium\" data-kid=\"2-2-2-5-2-1-1\" data-name=\"Header row\">\n                            <th class=\"text-left px-4 h-[40px] font-medium\" data-kid=\"2-2-2-5-2-1-1-1\" data-name=\"Month header\">\n                                Mes\n                            </th>\n                            <th class=\"text-right px-4 font-medium\" data-kid=\"2-2-2-5-2-1-1-2\" data-name=\"IVA adeudado header\">\n                                IVA adeudado\n                            </th>\n                            <th class=\"text-right px-4 font-medium\" data-kid=\"2-2-2-5-2-1-1-3\" data-name=\"IVA pagado header\">\n                                IVA pagado\n                            </th>\n                            <th class=\"text-right px-4 font-medium\" data-kid=\"2-2-2-5-2-1-1-4\" data-name=\"IT adeudado header\">\n                                IT adeudado\n                            </th>\n                            <th class=\"text-right px-4 font-medium\" data-kid=\"2-2-2-5-2-1-1-5\" data-name=\"IT pagado header\">\n                                IT pagado\n                            </th>\n                            <th class=\"text-right px-4 font-medium\" data-kid=\"2-2-2-5-2-1-1-6\" data-name=\"Diferencia header\">\n                                Diferencia\n                            </th>\n                            <th class=\"text-left px-4 pl-8 font-medium\" data-kid=\"2-2-2-5-2-1-1-7\" data-name=\"Estado header\">\n                                Estado\n                            </th>\n                        </tr>\n                    </thead>\n                    <tbody class=\"font-['IBM_Plex_Mono'] tabular-nums\" data-kid=\"2-2-2-5-2-2\" data-name=\"Table body\">\n                        <tr class=\"border-b border-[#E5EDF4] h-[44px] bg-white\" data-kid=\"2-2-2-5-2-2-1\" data-name=\"January row\">\n                            <td class=\"px-4 font-s