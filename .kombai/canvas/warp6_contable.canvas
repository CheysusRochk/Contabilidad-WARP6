        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700&family=Azeret+Mono:wght@400;500;600&display=swap');\n  .mono { font-family: 'Azeret Mono', monospace; font-feature-settings: 'tnum' 1, 'zero' 1; }\n  .dbl { display:inline-block; width:5px; height:13px; border-left:1px solid #9FB3A6; border-right:1px solid #9FB3A6; }\n  .rowline:hover { background:#F4F8F4; }\n</style>\n<div class=\"min-h-screen bg-[#F1F6F1] text-[#19251D]\" data-kid=\"1\" style=\"font-family:'Inter Tight',sans-serif;\">\n    <!-- ===== NAV LEVEL 1 (56px) ===== -->\n    <header class=\"h-14 bg-[#FCFDFC] border-b border-[#C9D6CC] px-6 flex items-center gap-8\" data-kid=\"1-1\">\n        <div class=\"flex items-baseline gap-2 shrink-0\" data-kid=\"1-1-1\">\n            <span class=\"mono font-semibold text-[16px] tracking-tight\" data-kid=\"1-1-1-1\">\n                WARP6\n            </span>\n            <span class=\"text-[11px] text-[#526259] font-medium\" data-kid=\"1-1-1-2\">\n                Solutions S.R.L.\n            </span>\n        </div>\n        <nav class=\"flex items-center gap-1 h-full\" data-kid=\"1-1-2\">\n            <a class=\"h-full px-3 flex items-center text-[14px] font-semibold text-[#19251D] border-b-2 border-[#2F684B]\" data-kid=\"1-1-2-1\">\n                Resumen\n            </a>\n            <a class=\"h-full px-3 flex items-center text-[14px] font-medium text-[#526259] hover:text-[#19251D]\" data-kid=\"1-1-2-2\">\n                Movimientos\n            </a>\n            <a class=\"h-full px-3 flex items-center text-[14px] font-medium text-[#526259] hover:text-[#19251D]\" data-kid=\"1-1-2-3\">\n                Reportes\n            </a>\n            <a class=\"h-full px-3 flex items-center text-[14px] font-medium text-[#526259] hover:text-[#19251D]\" data-kid=\"1-1-2-4\">\n                Activos\n            </a>\n            <a class=\"h-full px-3 flex items-center text-[14px] font-medium text-[#526259] hover:text-[#19251D]\" data-kid=\"1-1-2-5\">\n                Importar\n            </a>\n        </nav>\n        <div class=\"ml-auto flex items-center gap-4\" data-kid=\"1-1-3\">\n            <button class=\"h-8 px-3 border border-[#C9D6CC] rounded-[3px] bg-[#FCFDFC] text-[13px] font-medium flex items-center gap-2 hover:border-[#265C8F]\" data-kid=\"1-1-3-1\">\n                <span class=\"mono text-[12px]\" data-dynamic=\"true\" data-kid=\"1-1-3-1-1\" data-name=\"active financial period label\" data-reason=\"text content updated based on fiscal settings\">\n                    Ene – Sep 2026\n                </span>\n                <span class=\"text-[10px] text-[#526259]\" data-kid=\"1-1-3-1-2\">\n                    ▾\n                </span>\n            </button>\n            <div class=\"w-7 h-7 rounded-full bg-[#19251D] text-[#FCFDFC] flex items-center justify-center mono text-[11px] font-medium\" data-kid=\"1-1-3-2\">\n                AD\n            </div>\n        </div>\n    </header>\n    <!-- ===== NAV LEVEL 2 — barra de contexto (44px) ===== -->\n    <div class=\"h-11 bg-[#F6FAF6] border-b border-[#C9D6CC] px-6 flex items-center gap-6\" data-kid=\"1-2\">\n        <div class=\"flex items-stretch border border-[#C9D6CC] rounded-[3px] overflow-hidden bg-[#FCFDFC]\" data-kid=\"1-2-1\">\n            <button class=\"px-3 h-[28px] my-[2px] ml-[2px] text-[12px] font-semibold bg-[#E7F0E9] text-[#19251D] rounded-[2px]\" data-kid=\"1-2-1-1\">\n                SIN\n            </button>\n            <span class=\"flex items-center px-1\" data-kid=\"1-2-1-2\">\n                <span class=\"dbl\" data-kid=\"1-2-1-2-1\">\n                </span>\n            </span>\n            <button class=\"px-3 h-[28px] my-[2px] mr-[2px] text-[12px] font-medium text-[#526259] hover:text-[#19251D]\" data-kid=\"1-2-1-3\">\n                Real\n            </button>\n        </div>\n        <div class=\"mono text-[11.5px] text-[#526259] flex items-center gap-4\" data-kid=\"1-2-2\">\n            <span data-dynamic=\"true\" data-kid=\"1-2-2-1\" data-name=\"period start and end range text\" data-reason=\"text content updated based on selected fiscal period\">\n                Período: 01/01/2026 – 30/09/2026\n            </span>\n            <span class=\"text-[#C9D6CC]\" data-kid=\"1-2-2-2\">\n                |\n            </span>\n            <span data-dynamic=\"true\" data-kid=\"1-2-2-3\" data-name=\"final UFV rate value\" data-reason=\"numeric value updated from live financial records\">\n                UFV final: 2,5214\n            </span>\n            <span class=\"text-[#C9D6CC]\" data-kid=\"1-2-2-4\">\n                |\n            </span>\n            <span data-dynamic=\"true\" data-kid=\"1-2-2-5\" data-name=\"external expenses status text\" data-reason=\"status text updated based on accounting mode\">\n                Gastos externos: incluidos\n            </span>\n        </div>\n        <div class=\"ml-auto text-[12px] text-[#526259]\" data-kid=\"1-2-3\">\n            Lente activo:\n            <span class=\"font-semibold text-[#19251D]\" data-dynamic=\"true\" data-kid=\"1-2-3-1\" data-name=\"active lens status label\" data-reason=\"label text updated to reflect current fiscal compliance mode\">\n                SIN — cumplimiento fiscal\n            </span>\n        </div>\n    </div>\n    <main class=\"max-w-[1320px] mx-auto px-8 py-7 space-y-6\" data-kid=\"1-3\">\n        <!-- ===== 1. ESTADO BREVE ===== -->\n        <section class=\"bg-[#FCFDFC] border border-[#C9D6CC] rounded-[3px]\" data-kid=\"1-3-1\">\n            <div class=\"px-5 py-4 border-b border-[#C9D6CC] flex items-baseline justify-between\" data-kid=\"1-3-1-1\">\n                <div data-kid=\"1-3-1-1-1\">\n                    <h2 class=\"text-[15px] font-semibold\" data-kid=\"1-3-1-1-1-1\">\n                        Estado breve\n                    </h2>\n                    <p class=\"text-[12px] text-[#526259] mt-0.5\" data-kid=\"1-3-1-1-1-2\">\n                        Lectura dual de la operación · cada renglón abre los movimientos que lo componen\n                    </p>\n                </div>\n                <div class=\"grid grid-cols-[150px_24px_150px] items-center text-[11px] font-semibold uppercase tracking-wide text-[#526259]\" data-kid=\"1-3-1-1-2\">\n                    <span class=\"text-right text-[#19251D]\" data-dynamic=\"true\" data-kid=\"1-3-1-1-2-1\" data-name=\"SIN status column label\" data-reason=\"column label text depends on active lens mode\">\n                        SIN\n                    </span>\n                    <span data-kid=\"1-3-1-1-2-2\">\n                    </span>\n                    <span class=\"text-right\" data-dynamic=\"true\" data-kid=\"1-3-1-1-2-3\" data-name=\"Real status column label\" data-reason=\"column label text depends on active lens mode\">\n                        Real\n                    </span>\n                </div>\n            </div>\n            <div class=\"divide-y divide-[#E4ECE5]\" data-kid=\"1-3-1-2\">\n                <!-- Ventas -->\n                <div class=\"rowline grid grid-cols-[240px_1fr_150px_24px_150px] items-center px-5 h-14 cursor-pointer\" data-kid=\"1-3-1-2-1\">\n                    <span class=\"text-[14px] font-semibold\" data-kid=\"1-3-1-2-1-1\">\n                        Ventas\n                    </span>\n                    <span class=\"text-[12px] text-[#526259]\" data-dynamic=\"true\" data-kid=\"1-3-1-2-1-2\" data-name=\"sales description summary\" data-reason=\"summary text updated from financial summary calculations\">\n                        128 ingresos facturados · excluye aportes de capital\n                    </span>\n                    <span class=\"mono text-[15px] font-medium text-right\" data-dynamic=\"true\" data-kid=\"1-3-1-2-1-3\" data-name=\"SIN sales amount\" data-reason=\"amount updated from processed account data\">\n                        Bs 184.500,00\n                    </span>\n                    <span class=\"flex justify-center\" data-kid=\"1-3-1-2-1-4\">\n                        <span class=\"dbl\" data-kid=\"1-3-1-2-1-4-1\">\n                        </span>\n                    </span>\n                    <span class=\"mono text-[14px] text-right text-[#526259]\" data-dynamic=\"true\" data-kid=\"1-3-1-2-1-5\" data-name=\"Real sales amount\" data-reason=\"amount updated from processed account data\">\n                        Bs 184.500,00\n                    </span>\n                </div>\n                <!-- Gastos -->\n                <div class=\"rowline grid grid-cols-[240px_1fr_150px_24px_150px] items-center px-5 h-14 cursor-pointer\" data-kid=\"1-3-1-2-2\">\n                    <span class=\"text-[14px] font-semibold\" data-kid=\"1-3-1-2-2-1\">\n                        Gastos\n                    </span>\n                    <span class=\"text-[12px] text-[#526259]\" data-dynamic=\"true\" data-kid=\"1-3-1-2-2-2\" data-name=\"expenses description summary\" data-reason=\"summary text updated from financial summary calculations\">\n                        SIN: facturados y con retención · Real: incluye 14 sin factura\n                    </span>\n                    <span class=\"mono text-[15px] font-medium text-right\" data-dynamic=\"true\" data-kid=\"1-3-1-2-2-3\" data-name=\"SIN expenses amount\" data-reason=\"amount updated from processed account data\">\n                        Bs 84.760,00\n                    </span>\n                    <span class=\"flex justify-center\" data-kid=\"1-3-1-2-2-4\">\n                        <span class=\"dbl\" data-kid=\"1-3-1-2-2-4-1\">\n                        </span>\n                    </span>\n                    <span class=\"mono text-[14px] text-right text-[#A83F36]\" data-dynamic=\"true\" data-kid=\"1-3-1-2-2-5\" data-name=\"Real expenses amount\" data-reason=\"amount updated from processed account data\">\n                        Bs 97.240,00\n                    </span>\n                </div>\n                <!-- Resultado -->\n                <div class=\"rowline grid grid-cols-[240px_1fr_150px_24px_150px] items-center px-5 h-14 cursor-pointer border-t border-[#C9D6CC]\" data-kid=\"1-3-1-2-3\">\n                    <span class=\"text-[14px] font-semibold\" data-kid=\"1-3-1-2-3-1\">\n                        Resultado / caja\n                    </span>\n                    <span class=\"text-[12px] text-[#526259]\" data-dynamic=\"true\" data-kid=\"1-3-1-2-3-2\" data-name=\"result description summary\" data-reason=\"summary text updated from financial summary calculations\">\n                        SIN: después de IVA DF, IT y depreciación · Real: saldo disponible\n                    </span>\n                    <span class=\"mono text-[15px] font-semibold text-right\" data-dynamic=\"true\" data-kid=\"1-3-1-2-3-3\" data-name=\"SIN result amount\" data-reason=\"amount updated from processed account data\">\n                        Bs 68.415,00\n                    </span>\n                    <span class=\"flex justify-center\" data-kid=\"1-3-1-2-3-4\">\n                        <span class=\"dbl\" data-kid=\"1-3-1-2-3-4-1\">\n                        </span>\n                    </span>\n                    <span class=\"mono text-[14px] font-medium text-right text-[#526259]\" data-dynamic=\"true\" data-kid=\"1-3-1-2-3-5\" data-name=\"Real result amount\" data-reason=\"amount updated from processed account data\">\n                        Bs 37.260,00\n                    </span>\n                </div>\n            </div>\n            <p class=\"px-5 py-3 text-[11.5px] text-[#526259] border-t border-[#E4ECE5]\" data-kid=\"1-3-1-3\">\n                SIN: solo operaciones facturadas · Real: incluye caja y gastos sin factura\n            </p>\n        </section>\n        <!-- ===== 2. REQUIERE REVISIÓN ===== -->\n        <section class=\"bg-[#FCFDFC] border border-[#C9D6CC] rounded-[3px]\" data-kid=\"1-3-2\">\n            <div class=\"px-5 py-3.5 border-b border-[#C9D6CC] flex items-center justify-between\" data-kid=\"1-3-2-1\">\n                <h2 class=\"text-[15px] font-semibold\" data-kid=\"1-3-2-1-1\">\n                    Requiere revisión\n                </h2>\n                <span class=\"mono text-[11px] text-[#526259]\" data-dynamic=\"true\" data-kid=\"1-3-2-1-2\" data-name=\"open exceptions count text\" data-reason=\"counter text updated based on pending exception count\">\n                    3 excepciones abiertas\n                </span>\n            </div>\n            <div class=\"divide-y divide-[#E4ECE5]\" data-kid=\"1-3-2-2\">\n                <div class=\"flex items-center gap-3 px-5 h-11\" data-kid=\"1-3-2-2-1\">\n                    <span class=\"w-2 h-2 rounded-full bg-[#A83F36] shrink-0\" data-dynamic=\"true\" data-kid=\"1-3-2-2-1-1\" data-name=\"exception indicator dot\" data-reason=\"color state set dynamically by exception severity\">\n                    </span>\n                    <span class=\"text-[13.5px]\" data-kid=\"1-3-2-2-1-2\">\n                        <span class=\"mono font-medium\" data-dynamic=\"true\" data-kid=\"1-3-2-2-1-2-1\" data-name=\"exception amount text\" data-reason=\"amount updated from data records\">\n                            Bs 12.480,00\n                        </span>\n                        en gastos sin factura\n                    </span>\n                    <span class=\"text-[12px] text-[#526259] ml-2\" data-kid=\"1-3-2-2-1-3\">\n                        no reducen la base imponible del IUE\n                    </span>\n                    <a class=\"ml-auto text-[13px] font-medium text-[#265C8F] underline underline-offset-4 decoration-[#C9D6CC] hover:decoration-[#265C8F]\" data-kid=\"1-3-2-2-1-4\">\n                        Abrir\n                    </a>\n                </div>\n                <div class=\"flex items-center gap-3 px-5 h-11\" data-kid=\"1-3-2-2-2\">\n                    <span class=\"w-2 h-2 rounded-full bg-[#9D6318] shrink-0\" data-dynamic=\"true\" data-kid=\"1-3-2-2-2-1\" data-name=\"exception indicator dot\" data-reason=\"color state set dynamically by exception severity\">\n                    </span>\n                    <span class=\"text-[13.5px]\" data-kid=\"1-3-2-2-2-2\">\n                        Agosto tiene\n                        <span class=\"mono font-medium\" data-dynamic=\"true\" data-kid=\"1-3-2-2-2-2-1\" data-name=\"exception amount text\" data-reason=\"amount updated from data records\">\n                            Bs 2.340,00\n                        </span>\n                        pendiente de IVA e IT\n                    </span>\n                    <span class=\"text-[12px] text-[#526259] ml-2\" data-kid=\"1-3-2-2-2-3\">\n                        determinación supera a los pagos registrados\n                    </span>\n                    <a class=\"ml-auto text-[13px] font-medium text-[#265C8F] underline underline-offset-4 decoration-[#C9D6CC] hover:decoration-[#265C8F]\" data-kid=\"1-3-2-2-2-4\">\n                        Abrir\n                    </a>\n                </div>\n                <div class=\"flex items-center gap-3 px-5 h-11\" data-kid=\"1-3-2-2-3\">\n                    <span class=\"w-2 h-2 rounded-full bg-[#265C8F] shrink-0\" data-dynamic=\"true\" data-kid=\"1-3-2-2-3-1\" data-name=\"exception indicator dot\" data-reason=\"color state set dynamically by exception severity\">\n                    </span>\n                    <span class=\"text-[13.5px]\" data-kid=\"1-3-2-2-3-2\">\n                        2 movimientos superan el umbral de bancarización\n                        <span class=\"mono font-medium\" data-dynamic=\"true\" data-kid=\"1-3-2-2-3-2-1\" data-name=\"exception threshold amount\" data-reason=\"threshold value updated from config records\">\n                            (Bs 50.000)\n                        </span>\n                    </span>\n                    <span class=\"text-[12px] text-[#526259] ml-2\" data-kid=\"1-3-2-2-3-3\">\n                        requieren comprobante bancario\n                    </span>\n                    <a class=\"ml-auto text-[13px] font-medium text-[#265C8F] underline underline-offset-4 decoration-[#C9D6CC] hover:decoration-[#265C8F]\" data-kid=\"1-3-2-2-3-4\">\n                        Abrir\n                    </a>\n                </div>\n            </div>\n        </section>\n        <!-- ===== 3. FLUJO MENSUAL ===== -->\n        <section class=\"bg-[#FCFDFC] border border-[#C9D6CC] rounded-[3px]\" data-kid=\"1-3-3\">\n            <div class=\"px-5 py-4 border-b border-[#C9D6CC] flex items-center justify-between\" data-kid=\"1-3-3-1\">\n                <div data-kid=\"1-3-3-1-1\">\n                    <h2 class=\"text-[15px] font-semibold\" data-kid=\"1-3-3-1-1-1\">\n                        Flujo mensual\n                    </h2>\n                    <p class=\"text-[12px] text-[#526259] mt-0.5\" data-kid=\"1-3-3-1-1-2\">\n                        Ingresos entran, gastos salen · marcas ámbar indican pendiente IVA/IT\n                    </p>\n                </div>\n                <div class=\"flex items-stretch border border-[#C9D6CC] rounded-[3px] overflow-hidden\" data-kid=\"1-3-3-1-2\">\n                    <button class=\"px-3 h-7 text-[12px] font-semibold bg-[#E7F0E9] text-[#19251D]\" data-kid=\"1-3-3-1-2-1\">\n                        Ventas y gastos\n                    </button>\n                    <span class=\"w-px bg-[#C9D6CC]\" data-kid=\"1-3-3-1-2-2\">\n                    </span>\n                    <button class=\"px-3 h-7 text-[12px] font-medium text-[#526259] hover:text-[#19251D]\" data-kid=\"1-3-3-1-2-3\">\n                        IVA e IT\n                    </button>\n                </div>\n            </div>\n            <div class=\"px-5 pt-4 pb-5\" data-kid=\"1-3-3-2\">\n                <div class=\"h-[280px]\" data-kid=\"1-3-3-2-1\">\n                    <canvas data-dynamic=\"true\" data-kid=\"1-3-3-2-1-1\" data-name=\"monthly flow chart\" data-reason=\"canvas rendered and updated by chart.js\" id=\"flujoChart\">\n                    </canvas>\n                </div>\n            </div>\n        </section>\n        <!-- ===== 4 + 5: CATEGORÍAS + (fila con calendario debajo) ===== -->\n        <div class=\"grid grid-cols-12 gap-6\" data-kid=\"1-3-4\">\n            <section class=\"col-span-5 bg-[#FCFDFC] border border-[#C9D6CC] rounded-[3px]\" data-kid=\"1-3-4-1\">\n                <div class=\"px-5 py-4 border-b border-[#C9D6CC] flex items-center justify-between\" data-kid=\"1-3-4-1-1\">\n                    <h2 class=\"text-[15px] font-semibold\" data-kid=\"1-3-4-1-1-1\">\n                        Categorías de gasto\n                    </h2>\n                    <a class=\"text-[12.5px] font-medium text-[#265C8F] underline underline-offset-4 decoration-[#C9D6CC] hover:decoration-[#265C8F]\" data-kid=\"1-3-4-1-1-2\">\n                        Ver todas\n                    </a>\n                </div>\n                <table class=\"w-full text-[13px]\" data-kid=\"1-3-4-1-2\">\n                    <thead data-kid=\"1-3-4-1-2-1\">\n                        <tr class=\"text-[11px] uppercase tracking-wide text-[#526259] font-semibold\" data-kid=\"1-3-4-1-2-1-1\">\n                            <th class=\"text-left px-5 py-2.5 font-semibold\" data-kid=\"1-3-4-1-2-1-1-1\">\n                                Categoría\n                            </th>\n                            <th class=\"text-left px-2 py-2.5 font-semibold w-[170px]\" data-kid=\"1-3-4-1-2-1-1-2\">\n                                Participación\n                            </th>\n                            <th class=\"text-right px-2 py-2.5 font-semibold\" data-kid=\"1-3-4-1-2-1-1-3\">\n                                Monto\n                            </th>\n                            <th class=\"text-center px-5 py-2.5 font-semibold w-[70px]\" data-kid=\"1-3-4-1-2-1-1-4\">\n                               