      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n.ui { font-family: 'Inter', sans-serif; }\n.mono { font-family: 'IBM Plex Mono', monospace; font-variant-numeric: tabular-nums; }\n</style>\n<div class=\"ui min-h-screen bg-[#F4F8FC] text-[#17324D] text-[14px] antialiased\" data-kid=\"1\" data-name=\"accounting web application layout\">\n    <!-- ===== Left rail ===== -->\n    <aside class=\"fixed left-0 top-0 z-20 h-screen w-[228px] bg-white border-r border-[#D7E2EC] flex flex-col\" data-kid=\"1-1\" data-name=\"left navigation sidebar\">\n        <div class=\"flex items-center gap-2.5 px-5 h-16 border-b border-[#D7E2EC]\" data-kid=\"1-1-1\" data-name=\"brand logo and company info container\">\n            <div class=\"h-8 w-8 rounded-[8px] bg-[#2B68E8] text-white grid place-items-center font-bold text-[15px]\" data-kid=\"1-1-1-1\" data-name=\"brand initials logo\">\n                W6\n            </div>\n            <div class=\"leading-tight\" data-kid=\"1-1-1-2\" data-name=\"brand name and subtitle container\">\n                <p class=\"font-semibold text-[14px] tracking-tight\" data-kid=\"1-1-1-2-1\" data-name=\"brand company name text\">\n                    WARP6\n                </p>\n                <p class=\"text-[10.5px] text-[#52677C]\" data-kid=\"1-1-1-2-2\" data-name=\"company legal entity subtitle\">\n                    Solutions S.R.L.\n                </p>\n            </div>\n        </div>\n        <nav class=\"py-4 flex-1\" data-kid=\"1-1-2\" data-name=\"primary navigation links\">\n            <p class=\"px-5 pb-2 text-[10px] uppercase tracking-[0.1em] text-[#52677C]/70 font-medium\" data-kid=\"1-1-2-1\" data-name=\"navigation section header text\">\n                Navegación\n            </p>\n            <a class=\"relative flex items-center gap-3 px-5 h-10 text-[#52677C] hover:bg-[#F4F8FC] transition-colors\" data-kid=\"1-1-2-2\" data-name=\"dashboard navigation link\">\n                <i class=\"ti ti-layout-dashboard text-[18px]\" data-kid=\"1-1-2-2-1\" data-name=\"dashboard icon\">\n                </i>\n                <span class=\"text-[13.5px] font-medium\" data-kid=\"1-1-2-2-2\" data-name=\"dashboard link label\">\n                    Inicio\n                </span>\n            </a>\n            <a class=\"relative flex items-center gap-3 px-5 h-10 text-[#52677C] hover:bg-[#F4F8FC] transition-colors\" data-kid=\"1-1-2-3\" data-name=\"movements navigation link\">\n                <i class=\"ti ti-list-plus text-[18px]\" data-kid=\"1-1-2-3-1\" data-name=\"movements icon\">\n                </i>\n                <span class=\"text-[13.5px] font-medium\" data-kid=\"1-1-2-3-2\" data-name=\"movements link label\">\n                    Movimientos\n                </span>\n            </a>\n            <a class=\"relative flex items-center gap-3 px-5 h-10 text-[#52677C] hover:bg-[#F4F8FC] transition-colors\" data-kid=\"1-1-2-4\" data-name=\"reports navigation link\">\n                <i class=\"ti ti-file-chart-column text-[18px]\" data-kid=\"1-1-2-4-1\" data-name=\"reports icon\">\n                </i>\n                <span class=\"text-[13.5px] font-medium\" data-kid=\"1-1-2-4-2\" data-name=\"reports link label\">\n                    Reportes\n                </span>\n            </a>\n            <a class=\"relative flex items-center gap-3 px-5 h-10 text-[#52677C] hover:bg-[#F4F8FC] transition-colors\" data-kid=\"1-1-2-5\" data-name=\"assets navigation link\">\n                <i class=\"ti ti-computer text-[18px]\" data-kid=\"1-1-2-5-1\" data-name=\"assets icon\">\n                </i>\n                <span class=\"text-[13.5px] font-medium\" data-kid=\"1-1-2-5-2\" data-name=\"assets link label\">\n                    Activos\n                </span>\n            </a>\n            <!-- Active item -->\n            <a class=\"relative flex items-center gap-3 px-5 h-10 bg-[#2B68E8]/[0.07] text-[#1D4FD7]\" data-kid=\"1-1-2-6\" data-name=\"active import navigation link\">\n                <span class=\"absolute left-0 top-1.5 bottom-1.5 w-[3px] rounded-full bg-[#2B68E8]\" data-kid=\"1-1-2-6-1\" data-name=\"active state indicator bar\">\n                </span>\n                <i class=\"ti ti-file-up text-[18px]\" data-kid=\"1-1-2-6-2\" data-name=\"import icon\">\n                </i>\n                <span class=\"text-[13.5px] font-semibold\" data-kid=\"1-1-2-6-3\" data-name=\"import link label\">\n                    Importar\n                </span>\n            </a>\n        </nav>\n        <div class=\"px-5 py-4 border-t border-[#D7E2EC]\" data-kid=\"1-1-3\" data-name=\"system version info container\">\n            <p class=\"text-[11px] text-[#52677C]\" data-kid=\"1-1-3-1\" data-name=\"software version text\">\n                Sistema Contable v1.2\n            </p>\n            <p class=\"text-[10.5px] text-[#52677C]/70 mt-0.5\" data-kid=\"1-1-3-2\" data-name=\"legal compliance note text\">\n                Ley 843 · DS 24051\n            </p>\n        </div>\n    </aside>\n    <!-- ===== Main ===== -->\n    <main class=\"ml-[228px]\" data-kid=\"1-2\" data-name=\"main content area\">\n        <!-- Top bar -->\n        <header class=\"h-16 bg-white border-b border-[#D7E2EC] flex items-center justify-between px-8\" data-kid=\"1-2-1\" data-name=\"page top header\">\n            <div data-kid=\"1-2-1-1\" data-name=\"page title and subtitle container\">\n                <h1 class=\"text-[17px] font-semibold tracking-tight leading-tight\" data-kid=\"1-2-1-1-1\" data-name=\"page title heading\">\n                    Importar transacciones\n                </h1>\n                <p class=\"text-[12px] text-[#52677C] leading-tight\" data-kid=\"1-2-1-1-2\" data-name=\"page description text\">\n                    Carga masiva de movimientos desde Excel · paso 2 de 3\n                </p>\n            </div>\n            <div class=\"flex items-center gap-3\" data-kid=\"1-2-1-2\" data-name=\"user profile and tools container\">\n                <span class=\"flex items-center gap-2 h-8 px-3 rounded-[6px] border border-[#D7E2EC] bg-white text-[12.5px] text-[#52677C]\" data-kid=\"1-2-1-2-1\" data-name=\"date range selector\">\n                    <i class=\"ti ti-calendar-range text-[15px]\" data-kid=\"1-2-1-2-1-1\" data-name=\"calendar icon\">\n                    </i>\n                    01/01/2026 – 12/09/2026\n                </span>\n                <span class=\"h-8 w-8 rounded-full bg-[#17324D] text-white grid place-items-center text-[11px] font-semibold\" data-kid=\"1-2-1-2-2\" data-name=\"user profile initials icon\">\n                    CW\n                </span>\n            </div>\n        </header>\n        <div class=\"px-8 py-8\" data-kid=\"1-2-2\" data-name=\"main import workflow section\">\n            <div class=\"mx-auto max-w-[920px]\" data-kid=\"1-2-2-1\" data-name=\"workflow stepper and content wrapper\">\n                <!-- ===== Stepper ===== -->\n                <div class=\"flex items-center mb-8\" data-kid=\"1-2-2-1-1\" data-name=\"workflow stepper bar\">\n                    <!-- step 1 done -->\n                    <div class=\"flex items-center gap-3\" data-kid=\"1-2-2-1-1-1\" data-name=\"step 1 indicator container\">\n                        <span class=\"h-7 w-7 rounded-full bg-[#16735A] text-white grid place-items-center\" data-kid=\"1-2-2-1-1-1-1\" data-name=\"step 1 checkmark icon\">\n                            <i class=\"ti ti-check text-[15px]\" data-kid=\"1-2-2-1-1-1-1-1\" data-name=\"checkmark icon\">\n                            </i>\n                        </span>\n                        <div class=\"leading-tight\" data-kid=\"1-2-2-1-1-1-2\" data-name=\"step 1 label container\">\n                            <p class=\"text-[13px] font-medium text-[#52677C]\" data-kid=\"1-2-2-1-1-1-2-1\" data-name=\"step 1 title text\">\n                                1 · Descargar plantilla\n                            </p>\n                            <p class=\"text-[11px] text-[#16735A] font-medium\" data-kid=\"1-2-2-1-1-1-2-2\" data-name=\"step 1 status text\">\n                                Completado\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"flex-1 h-px bg-[#16735A]/50 mx-4\" data-kid=\"1-2-2-1-1-2\" data-name=\"stepper separator line 1\">\n                    </div>\n                    <!-- step 2 current -->\n                    <div class=\"flex items-center gap-3\" data-kid=\"1-2-2-1-1-3\" data-name=\"step 2 indicator container\">\n                        <span class=\"mono h-7 w-7 rounded-full bg-[#2B68E8] text-white grid place-items-center text-[13px] font-semibold ring-4 ring-[#2B68E8]/15\" data-kid=\"1-2-2-1-1-3-1\" data-name=\"step 2 number icon\">\n                            2\n                        </span>\n                        <div class=\"leading-tight\" data-kid=\"1-2-2-1-1-3-2\" data-name=\"step 2 label container\">\n                            <p class=\"text-[13px] font-semibold text-[#17324D]\" data-kid=\"1-2-2-1-1-3-2-1\" data-name=\"step 2 title text\">\n                                2 · Revisar archivo\n                            </p>\n                            <p class=\"text-[11px] text-[#1D4FD7] font-medium\" data-kid=\"1-2-2-1-1-3-2-2\" data-name=\"step 2 status text\">\n                                En curso\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"flex-1 h-px bg-[#D7E2EC] mx-4\" data-kid=\"1-2-2-1-1-4\" data-name=\"stepper separator line 2\">\n                    </div>\n                    <!-- step 3 -->\n                    <div class=\"flex items-center gap-3\" data-kid=\"1-2-2-1-1-5\" data-name=\"step 3 indicator container\">\n                        <span class=\"mono h-7 w-7 rounded-full border border-[#D7E2EC] bg-white text-[#52677C] grid place-items-center text-[13px] font-medium\" data-kid=\"1-2-2-1-1-5-1\" data-name=\"step 3 number icon\">\n                            3\n                        </span>\n                        <div class=\"leading-tight\" data-kid=\"1-2-2-1-1-5-2\" data-name=\"step 3 label container\">\n                            <p class=\"text-[13px] font-medium text-[#52677C]\" data-kid=\"1-2-2-1-1-5-2-1\" data-name=\"step 3 title text\">\n                                3 · Importar registros\n                            </p>\n                            <p class=\"text-[11px] text-[#52677C]/70\" data-kid=\"1-2-2-1-1-5-2-2\" data-name=\"step 3 status text\">\n                                Pendiente\n                            </p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"space-y-6\" data-kid=\"1-2-2-1-2\" data-name=\"import workflow steps container\">\n                    <!-- ===== STEP 1 — completed, compact ===== -->\n                    <section class=\"rounded-[10px] border border-[#D7E2EC] bg-white\" data-kid=\"1-2-2-1-2-1\" data-name=\"step 1 completed summary card\">\n                        <div class=\"flex items-center justify-between px-5 py-4 border-b border-[#D7E2EC]/70\" data-kid=\"1-2-2-1-2-1-1\" data-name=\"step 1 header\">\n                            <div data-kid=\"1-2-2-1-2-1-1-1\" data-name=\"step 1 header label\">\n                                <p class=\"text-[10px] uppercase tracking-[0.09em] text-[#52677C]/80 font-semibold\" data-kid=\"1-2-2-1-2-1-1-1-1\" data-name=\"step 1 header title\">\n                                    Paso 1\n                                </p>\n                                <h2 class=\"text-[15px] font-semibold tracking-tight\" data-kid=\"1-2-2-1-2-1-1-1-2\" data-name=\"step 1 header subtitle\">\n                                    Plantilla de importación\n                                </h2>\n                            </div>\n                            <span class=\"flex items-center gap-1.5 h-7 px-2.5 rounded-[6px] bg-[#16735A]/[0.09] text-[#16735A] text-[12px] font-semibold\" data-kid=\"1-2-2-1-2-1-1-2\" data-name=\"step 1 card title\">\n                                <i class=\"ti ti-circle-check text-[14px]\" data-kid=\"1-2-2-1-2-1-1-2-1\" data-name=\"step 1 status badge\">\n                                </i>\n                                Paso completado\n                            </span>\n                        </div>\n                        <div class=\"px-5 py-4\" data-kid=\"1-2-2-1-2-1-2\" data-name=\"step 1 card content\">\n                            <div class=\"flex items-center justify-between gap-6\" data-kid=\"1-2-2-1-2-1-2-1\" data-name=\"step 1 instructions row\">\n                                <p class=\"text-[13px] text-[#52677C]\" data-kid=\"1-2-2-1-2-1-2-1-1\" data-name=\"step 1 instruction text\">\n                                    Usa la plantilla para conservar el formato de fecha, factura y retención.\n                                </p>\n                                <div class=\"flex items-center gap-3 shrink-0\" data-kid=\"1-2-2-1-2-1-2-1-2\" data-name=\"step 1 actions container\">\n                                    <span class=\"mono text-[11px] text-[#1D4FD7] bg-[#2B68E8]/[0.07] border border-[#2B68E8]/25 rounded-[6px] px-2 py-1\" data-kid=\"1-2-2-1-2-1-2-1-2-1\" data-name=\"template version label\">\n                                        Plantilla v2 · 11 columnas\n                                    </span>\n                                    <button class=\"flex items-center gap-2 h-9 px-3.5 rounded-[7px] border border-[#C9D8E5] bg-white text-[#1D4FD7] text-[13px] font-semibold hover:border-[#2B68E8] transition-colors\" data-kid=\"1-2-2-1-2-1-2-1-2-2\" data-name=\"download template button\">\n                                        <i class=\"ti ti-download text-[16px]\" data-kid=\"1-2-2-1-2-1-2-1-2-2-1\" data-name=\"download icon\">\n                                        </i>\n                                        Descargar plantilla Excel\n                                    </button>\n                                </div>\n                            </div>\n                            <div class=\"mt-3 rounded-[6px] bg-[#F4F8FC] border border-[#D7E2EC]/70 px-3 py-2.5\" data-kid=\"1-2-2-1-2-1-2-2\" data-name=\"columns info container\">\n                                <p class=\"text-[10px] uppercase tracking-[0.08em] text-[#52677C]/70 font-semibold mb-1\" data-kid=\"1-2-2-1-2-1-2-2-1\" data-name=\"columns label\">\n                                    Columnas reconocidas\n                                </p>\n                                <p class=\"mono text-[11.5px] text-[#52677C] leading-relaxed\" data-kid=\"1-2-2-1-2-1-2-2-2\" data-name=\"columns list text\">\n                                    fecha · tipo · categoria · detalle · n_factura · nit · monto · metodo_pago · tiene_factura · aplica_retencion · proyecto\n                                </p>\n                            </div>\n                        </div>\n                    </section>\n                    <!-- ===== STEP 2 — active ===== -->\n                    <section class=\"rounded-[10px] border border-[#2B68E8]/35 bg-white\" data-kid=\"1-2-2-1-2-2\" data-name=\"step 2 active card\">\n                        <div class=\"flex items-center justify-between px-5 py-4 border-b border-[#D7E2EC]/70\" data-kid=\"1-2-2-1-2-2-1\" data-name=\"step 2 header\">\n                            <div data-kid=\"1-2-2-1-2-2-1-1\" data-name=\"step 2 header label\">\n                                <p class=\"text-[10px] uppercase tracking-[0.09em] text-[#52677C]/80 font-semibold\" data-kid=\"1-2-2-1-2-2-1-1-1\" data-name=\"step 2 header title\">\n                                    Paso 2\n                                </p>\n                                <h2 class=\"text-[15px] font-semibold tracking-tight\" data-kid=\"1-2-2-1-2-2-1-1-2\" data-name=\"step 2 header subtitle\">\n                                    Revisar archivo cargado\n                                </h2>\n                            </div>\n                            <span class=\"flex items-center gap-1.5 h-7 px-2.5 rounded-[6px] bg-[#2B68E8]/[0.09] text-[#1D4FD7] text-[12px] font-semibold\" data-kid=\"1-2-2-1-2-2-1-2\" data-name=\"step 2 card title\">\n                                <i class=\"ti ti-loader-2 text-[14px]\" data-kid=\"1-2-2-1-2-2-1-2-1\" data-name=\"step 2 status badge\">\n                                </i>\n                                En curso\n                            </span>\n                        </div>\n                        <div class=\"px-5 py-5 space-y-5\" data-kid=\"1-2-2-1-2-2-2\" data-name=\"step 2 card content\">\n                            <!-- File card -->\n                            <div class=\"flex items-center gap-4 rounded-[10px] border border-[#D7E2EC] bg-white px-4 py-3.5\" data-kid=\"1-2-2-1-2-2-2-1\" data-name=\"file details card\">\n                                <span class=\"h-11 w-11 shrink-0 rounded-[8px] bg-[#16735A]/[0.1] text-[#16735A] grid place-items-center\" data-kid=\"1-2-2-1-2-2-2-1-1\" data-name=\"file icon container\">\n                                    <i class=\"ti ti-file-spreadsheet text-[22px]\" data-kid=\"1-2-2-1-2-2-2-1-1-1\" data-name=\"spreadsheet icon\">\n                                    </i>\n                                </span>\n                                <div class=\"min-w-0 flex-1\" data-kid=\"1-2-2-1-2-2-2-1-2\" data-name=\"file name and info container\">\n                                    <p class=\"text-[14px] font-semibold truncate\" data-kid=\"1-2-2-1-2-2-2-1-2-1\" data-name=\"file name text\">\n                                        transacciones_2026.xlsx\n                                    </p>\n                                    <p class=\"text-[12px] text-[#52677C] mt-0.5\" data-kid=\"1-2-2-1-2-2-2-1-2-2\" data-name=\"file upload time text\">\n                                        86 KB · subido hace 2 minutos\n                                    </p>\n                                </div>\n                                <div class=\"flex items-center gap-4 shrink-0 text-[12.5px]\" data-kid=\"1-2-2-1-2-2-2-1-3\" data-name=\"file summary stats\">\n                                    <span class=\"mono text-[#17324D] font-medium\" data-kid=\"1-2-2-1-2-2-2-1-3-1\" data-name=\"total transactions detected\">\n                                        124\n                                        <span class=\"text-[#52677C] font-normal text-[11.5px]\" data-kid=\"1-2-2-1-2-2-2-1-3-1-1\" data-name=\"detected label\">\n                                            detectados\n                                        </span>\n                                    </span>\n                                    <span class=\"flex items-center gap-1.5 text-[#16735A] font-medium\" data-kid=\"1-2-2-1-2-2-2-1-3-2\" data-name=\"valid transactions summary\">\n                                        <span class=\"h-1.5 w-1.5 rounded-full bg-[#16735A]\" data-kid=\"1-2-2-1-2-2-2-1-3-2-1\" data-name=\"valid status dot\">\n                                        </span>\n                                        <span class=\"mono\" data-kid=\"1-2-2-1-2-2-2-1-3-2-2\" data-name=\"valid count\">\n                                            121\n                                        </span>\n                                        <span class=\"text-[11.5px] font-normal\" data-kid=\"1-2-2-1-2-2-2-1-3-2-3\" data-name=\"valid label\">\n                                            válidos\n                                        </span>\n                                    </span>\n                                    <span class=\"flex items-center gap-1.5 text-[#B5423C] font-medium\" data-kid=\"1-2-2-1-2-2-2-1-3-3\" data-name=\"error transactions summary\">\n                                        <span class=\"h-1.5 w-1.5 rounded-full bg-[#B5423C]\" data-kid=\"1-2-2-1-2-2-2-1-3-3-1\" data-name=\"error status dot\">\n                                        </span>\n                                        <span class=\"mono\" data-kid=\"1-2-2-1-2-2-2-1-3-3-2\" data-name=\"error count\">\n                                            3\n                                        </span>\n                                        <span class=\"text-[11.5px] font-normal\" data-kid=\"1-2-2-1-2-2-2-1-3-3-3\" data-name=\"error label\">\n                                            errores\n                                        </span>\n                                    </span>\n                                </div>\n                                <button class=\"shrink-0 flex items-center gap-1.5 h-8 px-3 rounded-[7px] border border-[#C9D8E5] bg-white text-[#17324D] text-[12.5px] font-medium hover:border-[#2B68E8] hover:text-[#1D4FD7] transition-colors\" data-kid=\"1-2-2-1-2-2-2-1-4\" data-name=\"replace file button\">\n                                    <i class=\"ti ti-refresh text-[14px]\" data-kid=\"1-2-2-1-2-2-2-1-4-1\" data-name=\"refresh icon\">\n                                    </i>\n                                    Reemplazar\n                                </button>\n                            </div>\n                            <!-- Validation errors -->\n                            <div data-kid=\"1-2-2-1-2-2-2-2\" data-name=\"validation errors list\">\n                                <div class=\"flex items-center justify-between mb-2.5\" data-kid=\"1-2-2-1-2-2-2-2-1\" data-name=\"validation errors header\">\n                                    <h3 class=\"text-[13.5px] font-semibold flex items-center gap-2\" data-kid=\"1-2-2-1-2-2-2-2-1-1\" data-name=\"validation error title\">\n                                        <i class=\"ti ti-circl