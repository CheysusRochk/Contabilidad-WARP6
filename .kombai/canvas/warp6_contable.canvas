 text-[11px] uppercase tracking-[0.04em] text-[#52677C]\" data-kid=\"2-2-3-1-2-2-1\">\n                            <th class=\"px-5 py-3 font-medium\" data-kid=\"2-2-3-1-2-2-1-1\">\n                                Activo\n                            </th>\n                            <th class=\"px-3 py-3 font-medium\" data-kid=\"2-2-3-1-2-2-1-2\">\n                                Fecha\n                            </th>\n                            <th class=\"px-3 py-3 font-medium text-right\" data-kid=\"2-2-3-1-2-2-1-3\">\n                                Valor inicial\n                            </th>\n                            <th class=\"px-3 py-3 font-medium text-right\" data-kid=\"2-2-3-1-2-2-1-4\">\n                                UFV actualizado\n                            </th>\n                            <th class=\"px-3 py-3 font-medium w-[150px]\" data-kid=\"2-2-3-1-2-2-1-5\">\n                                Depreciado\n                            </th>\n                            <th class=\"px-3 py-3 font-medium text-right\" data-kid=\"2-2-3-1-2-2-1-6\">\n                                Neto\n                            </th>\n                            <th class=\"px-4 py-3 w-[44px]\" data-kid=\"2-2-3-1-2-2-1-7\">\n                            </th>\n                        </tr>\n                    </thead>\n                    <tbody data-kid=\"2-2-3-1-2-3\">\n                        <!-- Fila 1: Servidor -->\n                        <tr class=\"border-t border-[#EAF0F6] bg-[#F7FAFD]\" data-kid=\"2-2-3-1-2-3-1\">\n                            <td class=\"px-5 py-3.5\" data-kid=\"2-2-3-1-2-3-1-1\" data-name=\"asset name container\">\n                                <p class=\"font-medium text-[#17324D] flex items-center gap-1.5 whitespace-nowrap\" data-kid=\"2-2-3-1-2-3-1-1-1\" data-name=\"asset row toggle button\">\n                                    <i class=\"ti ti-chevron-down text-[14px] text-[#2B68E8]\" data-kid=\"2-2-3-1-2-3-1-1-1-1\" data-name=\"chevron toggle icon\">\n                                    </i>\n                                    Servidor Dell PowerEdge R650\n                                </p>\n                                <p class=\"text-[11.5px] text-[#52677C] mt-0.5\" data-kid=\"2-2-3-1-2-3-1-1-2\">\n                                    Equipos de Computación\n                                </p>\n                            </td>\n                            <td class=\"px-3 py-3.5 num text-[12.5px] text-[#52677C]\" data-kid=\"2-2-3-1-2-3-1-2\">\n                                15/03/2024\n                            </td>\n                            <td class=\"px-3 py-3.5 num text-right text-[#17324D]\" data-kid=\"2-2-3-1-2-3-1-3\">\n                                24.000,00\n                            </td>\n                            <td class=\"px-3 py-3.5 num text-right text-[#17324D]\" data-kid=\"2-2-3-1-2-3-1-4\">\n                                24.551,42\n                            </td>\n                            <td class=\"px-3 py-3.5\" data-kid=\"2-2-3-1-2-3-1-5\">\n                                <p class=\"text-[12px] font-medium text-[#17324D]\" data-kid=\"2-2-3-1-2-3-1-5-1\">\n                                    63% depreciado\n                                </p>\n                                <div class=\"mt-1 h-[6px] w-full bg-[#E3EAF2] rounded-full overflow-hidden\" data-kid=\"2-2-3-1-2-3-1-5-2\">\n                                    <div class=\"h-full bg-[#2B68E8] rounded-full\" data-kid=\"2-2-3-1-2-3-1-5-2-1\" style=\"width:63%\">\n                                    </div>\n                                </div>\n                                <p class=\"mt-1 text-[11px] num text-[#52677C]\" data-kid=\"2-2-3-1-2-3-1-5-3\">\n                                    Bs 15.467,40\n                                </p>\n                            </td>\n                            <td class=\"px-3 py-3.5 num text-right font-medium text-[#17324D]\" data-kid=\"2-2-3-1-2-3-1-6\">\n                                9.084,02\n                            </td>\n                            <td class=\"px-4 py-3.5 text-right\" data-kid=\"2-2-3-1-2-3-1-7\">\n                                <button class=\"w-8 h-8 grid place-items-center rounded-[6px] text-[#8FA3B5] hover:text-[#B5423C] hover:bg-[#FFF1F0]\" data-kid=\"2-2-3-1-2-3-1-7-1\">\n                                    <i class=\"ti ti-trash text-[15px]\" data-kid=\"2-2-3-1-2-3-1-7-1-1\">\n                                    </i>\n                                </button>\n                            </td>\n                        </tr>\n                        <!-- Fila expandida: cálculo -->\n                        <tr class=\"bg-[#F7FAFD]\" data-kid=\"2-2-3-1-2-3-2\">\n                            <td class=\"px-5 pb-5 pt-1 border-t border-[#EAF0F6]\" colspan=\"7\" data-kid=\"2-2-3-1-2-3-2-1\">\n                                <p class=\"text-[11px] uppercase tracking-[0.05em] font-semibold text-[#52677C] mb-2.5\" data-kid=\"2-2-3-1-2-3-2-1-1\">\n                                    Cálculo de depreciación y ajuste UFV\n                                </p>\n                                <div class=\"num text-[12.5px] text-[#17324D] space-y-1.5 bg-white border border-[#D7E2EC] rounded-[8px] px-4 py-3.5 inline-block\" data-kid=\"2-2-3-1-2-3-2-1-2\">\n                                    <p data-kid=\"2-2-3-1-2-3-2-1-2-1\">\n                                        Valor inicial Bs 24.000,00 × (UFV actual 2,51840 ÷ UFV compra 2,46210) =\n                                        <span class=\"font-semibold\" data-kid=\"2-2-3-1-2-3-2-1-2-1-1\">\n                                            Bs 24.551,42\n                                        </span>\n                                    </p>\n                                    <p data-kid=\"2-2-3-1-2-3-2-1-2-2\">\n                                        Bs 24.551,42 − Depreciación acumulada Bs 15.467,40 =\n                                        <span class=\"font-semibold\" data-kid=\"2-2-3-1-2-3-2-1-2-2-1\">\n                                            Valor neto en libros Bs 9.084,02\n                                        </span>\n                                    </p>\n                                </div>\n                                <div class=\"mt-3 flex items-center gap-2\" data-kid=\"2-2-3-1-2-3-2-1-3\">\n                                    <button class=\"h-8 px-3 rounded-[6px] bg-white border border-[#C9D8E5] text-[12.5px] font-semibold text-[#1D4FBF] flex items-center gap-1.5\" data-kid=\"2-2-3-1-2-3-2-1-3-1\">\n                                        <i class=\"ti ti-calculator text-[14px]\" data-kid=\"2-2-3-1-2-3-2-1-3-1-1\">\n                                        </i>\n                                        Calcular actualización\n                                    </button>\n                                    <button class=\"h-8 px-3 rounded-[6px] bg-white border border-[#E4C4C1] text-[12.5px] font-medium text-[#B5423C] flex items-center gap-1.5\" data-kid=\"2-2-3-1-2-3-2-1-3-2\">\n                                        <i class=\"ti ti-trash text-[14px]\" data-kid=\"2-2-3-1-2-3-2-1-3-2-1\">\n                                        </i>\n                                        Eliminar\n                                    </button>\n                                </div>\n                            </td>\n                        </tr>\n                        <!-- Fila 2: Vehículo -->\n                        <tr class=\"border-t border-[#EAF0F6]\" data-kid=\"2-2-3-1-2-3-3\">\n                            <td class=\"px-5 py-3.5\" data-kid=\"2-2-3-1-2-3-3-1\">\n                                <p class=\"font-medium text-[#17324D] whitespace-nowrap\" data-kid=\"2-2-3-1-2-3-3-1-1\" data-name=\"asset name text\">\n                                    Vehículo Mitsubishi L200\n                                </p>\n                                <p class=\"text-[11.5px] text-[#52677C] mt-0.5\" data-kid=\"2-2-3-1-2-3-3-1-2\">\n                                    Vehículos Automotores\n                                </p>\n                                <p class=\"text-[11px] text-[#B86B13] mt-1 flex items-center gap-1\" data-kid=\"2-2-3-1-2-3-3-1-3\">\n                                    <i class=\"ti ti-alert-triangle text-[12px]\" data-kid=\"2-2-3-1-2-3-3-1-3-1\">\n                                    </i>\n                                    Vida útil próxima a agotarse\n                                </p>\n                            </td>\n                            <td class=\"px-3 py-3.5 num text-[12.5px] text-[#52677C]\" data-kid=\"2-2-3-1-2-3-3-2\">\n                                05/06/2021\n                            </td>\n                            <td class=\"px-3 py-3.5 num text-right text-[#17324D]\" data-kid=\"2-2-3-1-2-3-3-3\">\n                                32.000,00\n                            </td>\n                            <td class=\"px-3 py-3.5 num text-right text-[#17324D]\" data-kid=\"2-2-3-1-2-3-3-4\">\n                                33.193,73\n                            </td>\n                            <td class=\"px-3 py-3.5\" data-kid=\"2-2-3-1-2-3-3-5\">\n                                <p class=\"text-[12px] font-medium text-[#B86B13]\" data-kid=\"2-2-3-1-2-3-3-5-1\">\n                                    84% depreciado\n                                </p>\n                                <div class=\"mt-1 h-[6px] w-full bg-[#E3EAF2] rounded-full overflow-hidden\" data-kid=\"2-2-3-1-2-3-3-5-2\">\n                                    <div class=\"h-full bg-[#2B68E8] rounded-full\" data-kid=\"2-2-3-1-2-3-3-5-2-1\" style=\"width:84%\">\n                                    </div>\n                                </div>\n                                <p class=\"mt-1 text-[11px] num text-[#52677C]\" data-kid=\"2-2-3-1-2-3-3-5-3\">\n                                    Bs 2