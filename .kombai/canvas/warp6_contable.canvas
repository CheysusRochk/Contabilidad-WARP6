      "html": "<link data-kid=\"1\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap');\n  body { font-family: 'Inter', sans-serif; color: #17324D; background: #F4F8FC; }\n  .num { font-family: 'IBM Plex Mono', monospace; font-variant-numeric: tabular-nums; }\n</style>\n<div class=\"min-h-screen bg-[#F4F8FC] flex\" data-kid=\"2\">\n    <!-- ============ RAIL IZQUIERDO ============ -->\n    <aside class=\"fixed inset-y-0 left-0 w-[228px] bg-white border-r border-[#D7E2EC] flex flex-col z-20\" data-kid=\"2-1\">\n        <div class=\"h-16 flex items-center gap-2.5 px-5 border-b border-[#D7E2EC]\" data-kid=\"2-1-1\">\n            <div class=\"w-8 h-8 rounded-[8px] bg-[#17324D] text-white grid place-items-center shrink-0\" data-kid=\"2-1-1-1\">\n                <i class=\"ti ti-calculator text-[16px]\" data-kid=\"2-1-1-1-1\">\n                </i>\n            </div>\n            <div class=\"leading-tight\" data-kid=\"2-1-1-2\">\n                <p class=\"text-[14px] font-semibold text-[#17324D]\" data-kid=\"2-1-1-2-1\">\n                    WARP6\n                </p>\n                <p class=\"text-[11px] text-[#52677C]\" data-kid=\"2-1-1-2-2\">\n                    Solutions S.R.L.\n                </p>\n            </div>\n        </div>\n        <nav class=\"py-4 flex-1\" data-kid=\"2-1-2\">\n            <a class=\"relative flex items-center gap-3 h-10 px-5 text-[13.5px] text-[#52677C]\" data-kid=\"2-1-2-1\" href=\"#\">\n                <i class=\"ti ti-layout-dashboard text-[17px]\" data-kid=\"2-1-2-1-1\">\n                </i>\n                Inicio\n            </a>\n            <a class=\"relative flex items-center gap-3 h-10 px-5 text-[13.5px] text-[#52677C]\" data-kid=\"2-1-2-2\" href=\"#\">\n                <i class=\"ti ti-list text-[17px]\" data-kid=\"2-1-2-2-1\">\n                </i>\n                Movimientos\n            </a>\n            <a class=\"relative flex items-center gap-3 h-10 px-5 text-[13.5px] text-[#52677C]\" data-kid=\"2-1-2-3\" href=\"#\">\n                <i class=\"ti ti-chart-bar text-[17px]\" data-kid=\"2-1-2-3-1\">\n                </i>\n                Reportes\n            </a>\n            <a class=\"relative flex items-center gap-3 h-10 px-5 text-[13.5px] font-semibold text-[#1D4FBF] bg-[#EEF4FE]\" data-kid=\"2-1-2-4\" href=\"#\">\n                <span class=\"absolute left-0 top-1.5 bottom-1.5 w-[3px] rounded-r-[2px] bg-[#2B68E8]\" data-kid=\"2-1-2-4-1\">\n                </span>\n                <i class=\"ti ti-device-desktop text-[17px]\" data-kid=\"2-1-2-4-2\">\n                </i>\n                Activos\n            </a>\n            <a class=\"relative flex items-center gap-3 h-10 px-5 text-[13.5px] text-[#52677C]\" data-kid=\"2-1-2-5\" href=\"#\">\n                <i class=\"ti ti-file-upload text-[17px]\" data-kid=\"2-1-2-5-1\">\n                </i>\n                Importar\n            </a>\n        </nav>\n        <div class=\"px-5 py-4 border-t border-[#D7E2EC]\" data-kid=\"2-1-3\">\n            <p class=\"text-[11px] text-[#52677C]\" data-kid=\"2-1-3-1\">\n                Ley 843 · DS 24051\n            </p>\n            <p class=\"text-[11px] text-[#8FA3B5] mt-1\" data-kid=\"2-1-3-2\">\n                Sistema Contable v1.2\n            </p>\n        </div>\n    </aside>\n    <!-- ============ CONTENIDO ============ -->\n    <main class=\"ml-[228px] flex-1 px-8 py-7 min-w-0\" data-kid=\"2-2\">\n        <!-- Encabezado -->\n        <div class=\"flex items-start justify-between\" data-kid=\"2-2-1\">\n            <div data-kid=\"2-2-1-1\">\n                <h1 class=\"text-[22px] font-semibold text-[#17324D] tracking-[-0.01em]\" data-kid=\"2-2-1-1-1\">\n                    Activos fijos\n                </h1>\n                <p class=\"text-[13px] text-[#52677C] mt-1\" data-kid=\"2-2-1-1-2\">\n                    Cálculo referencial según DS 24051 · Equipos de computación: 4 años (25% anual)\n                </p>\n            </div>\n            <button class=\"h-9 px-4 rounded-[7px] bg-[#2B68E8] text-white text-[13px] font-semibold flex items-center gap-2\" data-kid=\"2-2-1-2\">\n                <i class=\"ti ti-plus text-[15px]\" data-kid=\"2-2-1-2-1\">\n                </i>\n                Registrar activo\n            </button>\n        </div>\n        <!-- Banda de totales -->\n        <div class=\"mt-6 bg-white border border-[#D7E2EC] rounded-[10px] grid grid-cols-4 divide-x divide-[#D7E2EC]\" data-kid=\"2-2-2\">\n            <div class=\"px-6 py-4\" data-kid=\"2-2-2-1\">\n                <p class=\"text-[11px] uppercase tracking-[0.05em] text-[#52677C] font-medium\" data-kid=\"2-2-2-1-1\">\n                    Valor inicial\n                </p>\n                <p class=\"num text-[18px] text-[#17324D] mt-1.5\" data-kid=\"2-2-2-1-2\">\n                    Bs 86.400,00\n                </p>\n            </div>\n            <div class=\"px-6 py-4\" data-kid=\"2-2-2-2\">\n                <p class=\"text-[11px] uppercase tracking-[0.05em] text-[#52677C] font-medium\" data-kid=\"2-2-2-2-1\">\n                    Actualizado por UFV\n                </p>\n                <p class=\"num text-[18px] text-[#17324D] mt-1.5\" data-kid=\"2-2-2-2-2\">\n                    Bs 88.820,00\n                </p>\n            </div>\n            <div class=\"px-6 py-4\" data-kid=\"2-2-2-3\">\n                <p class=\"text-[11px] uppercase tracking-[0.05em] text-[#52677C] font-medium\" data-kid=\"2-2-2-3-1\">\n                    Depreciación acumulada\n                </p>\n                <p class=\"num text-[18px] text-[#52677C] mt-1.5\" data-kid=\"2-2-2-3-2\">\n                    Bs 60.770,87\n                </p>\n            </div>\n            <div class=\"px-6 py-4\" data-kid=\"2-2-2-4\">\n                <p class=\"text-[11px] upper