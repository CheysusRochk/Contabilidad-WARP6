     <td class=\"mono px-3 text-right font-medium\" data-kid=\"1-2-2-1-2-2-2-3-2-1-2-5-6\" data-name=\"amount column\">\n                                                    12.400,00\n                                                </td>\n                                                <td class=\"px-4\" data-kid=\"1-2-2-1-2-2-2-3-2-1-2-5-7\" data-name=\"invoice column\">\n                                                    <i class=\"ti ti-circle-x text-[15px] text-[#B5423C]/70\" data-kid=\"1-2-2-1-2-2-2-3-2-1-2-5-7-1\" data-name=\"invoice status icon\">\n                                                    </i>\n                                                    <span class=\"ml-1 text-[12px] text-[#52677C]\" data-kid=\"1-2-2-1-2-2-2-3-2-1-2-5-7-2\" data-name=\"invoice status text\">\n                                                        No\n                                                    </span>\n                                                </td>\n                                            </tr>\n                                            <tr class=\"h-11 bg-[#FFF1F0]\" data-kid=\"1-2-2-1-2-2-2-3-2-1-2-6\" data-name=\"data row 6 (error)\">\n                                                <td class=\"mono px-4 text-[#B5423C] font-semibold\" data-kid=\"1-2-2-1-2-2-2-3-2-1-2-6-1\" data-name=\"row number\">\n                                                    89\n                                                </td>\n                                                <td class=\"mono px-3 text-[12.5px]\" data-kid=\"1-2-2-1-2-2-2-3-2-1-2-6-2\" data-name=\"date column\">\n                                                    2026-09-03\n                                                </td>\n                                                <td class=\"px-3\" data-kid=\"1-2-2-1-2-2-2-3-2-1-2-6-3\" data-name=\"type column\">\n                                                    <span class=\"flex items-center gap-1.5\" data-kid=\"1-2-2-1-2-2-2-3-2-1-2-6-3-1\" data-name=\"type indicator\">\n                                                        <span class=\"h-1.5 w-1.5 rounded-full bg-[#B5423C]\" data-kid=\"1-2-2-1-2-2-2-3-2-1-2-6-3-1-1\" data-name=\"type dot\">\n                                                        </span>\n                                                        Gasto\n                                                    </span>\n                                                </td>\n                                                <td class=\"px-3 text-[#52677C]\" data-kid=\"1-2-2-1-2-2-2-3-2-1-2-6-4\" data-name=\"category column\">\n                                                    Refrigerio\n                                                </td>\n                                                <td class=\"px-3 truncate max-w-[280px]\" data-kid=\"1-2-2-1-2-2-2-3-2-1-2-6-5\" data-name=\"detail column\">\n                                                    Refrigerio reunión técnica\n                                                </td>\n                                                <td class=\"px-3 text-right\" data-kid=\"1-2-2-1-2-2-2-3-2-1-2-6-6\" data-name=\"amount column\">\n                                                    <span class=\"mono font-semibold text-[#B5423C] underline decoration-[#B5423C] decoration-2 underline-offset-4\" data-kid=\"1-2-2-1-2-2-2-3-2-1-2-6-6-1\" data-name=\"amount error text\">\n                                                        s/n\n                                                    </span>\n                                                </td>\n                                                <td class=\"px-4\" data-kid=\"1-2-2-1-2-2-2-3-2-1-2-6-7\" data-name=\"invoice column\">\n                                                    <i class=\"ti ti-circle-x text-[15px] text-[#B5423C]/70\" data-kid=\"1-2-2-1-2-2-2-3-2-1-2-6-7-1\" data-name=\"invoice status icon\">\n                                                    </i>\n                                                    <span class=\"ml-1 text-[12px] text-[#52677C]\" data-kid=\"1-2-2-1-2-2-2-3-2-1-2-6-7-2\" data-name=\"invoice status text\">\n                                                        No\n                                                    </span>\n                                                </td>\n                                            </tr>\n                                        </tbody>\n                                    </table>\n                                    <div class=\"flex items-center justify-between px-4 py-2.5 bg-[#F4F8FC] border-t border-[#D7E2EC] text-[12px] text-[#52677C]\" data-kid=\"1-2-2-1-2-2-2-3-2-2\" data-name=\"pagination controls\">\n                                        <p data-kid=\"1-2-2-1-2-2-2-3-2-2-1\" data-name=\"pagination info text\">\n                                            Mostrando\n                                            <span class=\"mono\" data-kid=\"1-2-2-1-2-2-2-3-2-2-1-1\" data-name=\"total record count\">\n                                                6\n                                            </span>\n                                            de\n                                            <span class=\"mono\" data-kid=\"1-2-2-1-2-2-2-3-2-2-1-2\" data-name=\"pagination record counter text\">\n                                                124\n                                            </span>\n                                            filas ·\n                                            <span class=\"mono text-[#B5423C] font-semibold\" data-kid=\"1-2-2-1-2-2-2-3-2-2-1-3\" data-name=\"error record count\">\n                                                3\n                                            </span>\n                                            con errores\n                                        </p>\n                                        <div class=\"flex items-center gap-1\" data-kid=\"1-2-2-1-2-2-2-3-2-2-2\" data-name=\"nav buttons\">\n                                            <button class=\"h-7 w-7 rounded-[6px] border border-[#D7E2EC] bg-white grid place-items-center text-[#52677C]\" data-kid=\"1-2-2-1-2-2-2-3-2-2-2-1\" data-name=\"previous page button\">\n                                                <i class=\"ti ti-chevron-left text-[14px]\" data-kid=\"1-2-2-1-2-2-2-3-2-2-2-1-1\" data-name=\"prev icon\">\n                                                </i>\n                                            </button>\n                                            <span class=\"mono px-2 text-[12px]\" data-kid=\"1-2-2-1-2-2-2-3-2-2-2-2\" data-name=\"page number text\">\n                                                1 / 21\n                                            </span>\n                                            <button class=\"h-7 w-7 rounded-[6px] border border-[#D7E2EC] bg-white grid place-items-center text-[#1D4FD7]\" data-kid=\"1-2-2-1-2-2-2-3-2-2-2-3\" data-name=\"next page button\">\n                                                <i class=\"ti ti-chevron-right text-[14px]\" data-kid=\"1-2-2-1-2-2-2-3-2-2-2-3-1\" data-name=\"next icon\">\n                                                </i>\n                                            </button>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </section>\n                    <!-- ===== STEP 3 — upcoming, dimmed ===== -->\n                    <section class=\"rounded-[10px] border border-[#D7E2EC] bg-white opacity-[0.55]\" data-kid=\"1-2-2-1-2-3\" data-name=\"step 3 card\">\n                        <div class=\"flex items-center justify-between px-5 py-4 border-b border-[#D7E2EC]/70\" data-kid=\"1-2-2-1-2-3-1\" data-name=\"step 3 header\">\n                            <div data-kid=\"1-2-2-1-2-3-1-1\" data-name=\"step 3 header label\">\n                                <p class=\"text-[10px] uppercase tracking-[0.09em] text-[#52677C]/80 font-semibold\" data-kid=\"1-2-2-1-2-3-1-1-1\" data-name=\"step 3 header title\">\n                                    Paso 3\n                                </p>\n                                <h2 class=\"text-[15px] font-semibold tracking-tight\" data-kid=\"1-2-2-1-2-3-1-1-2\" data-name=\"step 3 header subtitle\">\n                                    Confirmar e importar\n                                </h2>\n                            </div>\n                            <span class=\"flex items-center gap-1.5 h-7 px-2.5 rounded-[6px] bg-[#F4F8FC] border border-[#D7E2EC] text-[#52677C] text-[12px] font-medium\" data-kid=\"1-2-2-1-2-3-1-2\" data-name=\"step 3 status badge\">\n                                <i class=\"ti ti-lock text-[13px]\" data-kid=\"1-2-2-1-2-3-1-2-1\" data-name=\"locked status icon\">\n                                </i>\n                                Bloqueado\n                            </span>\n                        </div>\n                        <div class=\"px-5 py-5 space-y-4\" data-kid=\"1-2-2-1-2-3-2\" data-name=\"step 3 content\">\n                            <div class=\"space-y-1.5\" data-kid=\"1-2-2-1-2-3-2-1\" data-name=\"import summary stats\">\n                                <p class=\"flex items-center gap-2.5 text-[13.5px]\" data-kid=\"1-2-2-1-2-3-2-1-1\" data-name=\"valid import count row\">\n                                    <span class=\"h-1.5 w-1.5 rounded-full bg-[#16735A]\" data-kid=\"1-2-2-1-2-3-2-1-1-1\" data-name=\"valid status dot\">\n                                    </span>\n                                    Se importarán:\n                                    <span class=\"mono font-semibold\" data-kid=\"1-2-2-1-2-3-2-1-1-2\" data-name=\"valid import count\">\n                                        121\n                                    </span>\n                                    transacciones\n                                </p>\n                                <p class=\"flex items-center gap-2.5 text-[13.5px]\" data-kid=\"1-2-2-1-2-3-2-1-2\" data-name=\"error import count row\">\n                                    <span class=\"h-1.5 w-1.5 rounded-full bg-[#B5423C]\" data-kid=\"1-2-2-1-2-3-2-1-2-1\" data-name=\"error status dot\">\n                                    </span>\n                                    No se importarán:\n                                    <span class=\"mono font-semibold\" data-kid=\"1-2-2-1-2-3-2-1-2-2\" data-name=\"error import count\">\n                                        3\n                                    </span>\n                                    registros con error\n                                </p>\n                            </div>\n                            <label class=\"flex items-start gap-2.5 cursor-pointer\" data-kid=\"1-2-2-1-2-3-2-2\" data-name=\"import options checkbox\">\n                                <input checked=\"\" class=\"mt-0.5 h-4 w-4 accent-[#2B68E8]\" data-kid=\"1-2-2-1-2-3-2-2-1\" data-name=\"checkbox input\" type=\"checkbox\"/>\n                                <span data-kid=\"1-2-2-1-2-3-2-2-2\" data-name=\"checkbox label\">\n                                    <span class=\"text-[13.5px] font-medium\" data-kid=\"1-2-2-1-2-3-2-2-2-1\" data-name=\"checkbox primary label\">\n                                        Reemplazar transacciones existentes\n                                    </span>\n                                    <span class=\"block text-[12px] text-[#B5423C] mt-0.5 flex items-center gap-1.5\" data-kid=\"1-2-2-1-2-3-2-2-2-2\" data-name=\"checkbox warning note\">\n                                        <i class=\"ti ti-alert-triangle text-[14px]\" data-kid=\"1-2-2-1-2-3-2-2-2-2-1\" data-name=\"warning icon\">\n                                        </i>\n                                        Se eliminarán las transacciones actuales. Los activos fijos se conservarán.\n                                    </span>\n                                </span>\n                            </label>\n                            <div class=\"pt-1\" data-kid=\"1-2-2-1-2-3-2-3\" data-name=\"import action area\">\n                                <button class=\"flex items-center gap-2 h-10 px-4 rounded-[7px] bg-[#2B68E8]/40 text-white text-[13.5px] font-semibold cursor-not-allowed\" data-kid=\"1-2-2-1-2-3-2-3-1\" data-name=\"import button\" disabled=\"\">\n                                    <i class=\"ti ti-lock text-[15px]\" data-kid=\"1-2-2-1-2-3-2-3-1-1\" data-name=\"lock icon\">\n                                    </i>\n                                    Importar 121 registros\n                                </button>\n                                <p class=\"flex items-center gap-1.5 text-[12px] text-[#B86B13] font-medium mt-2\" data-kid=\"1-2-2-1-2-3-2-3-2\" data-name=\"action error note\">\n                                    <i class=\"ti ti-circle-alert text-[14px]\" data-kid=\"1-2-2-1-2-3-2-3-2-1\" data-name=\"warning icon\">\n                                    </i>\n                                    Corrige los 3 errores para continuar\n                                </p>\n                            </div>\n                            <div class=\"rounded-[6px] bg-[#F4F8FC] border border-[#D7E2EC]/70 px-3.5 py-3\" data-kid=\"1-2-2-1-2-3-2-4\" data-name=\"progress example container\">\n                                <div class=\"flex items-center justify-between mb-2\" data-kid=\"1-2-2-1-2-3-2-4-1\" data-name=\"progress header\">\n                                    <p class=\"text-[11px] uppercase tracking-[0.08em] text-[#52677C]/80 font-semibold\" data-kid=\"1-2-2-1-2-3-2-4-1-1\" data-name=\"progress header text\">\n                                        Progreso de importación — ejemplo\n                                    </p>\n                                    <p class=\"mono text-[12px] font-medium text-[#17324D]\" data-kid=\"1-2-2-1-2-3-2-4-1-2\" data-name=\"progress record count\">\n                                        46 de 124 registros\n                                    </p>\n                                </div>\n                                <div class=\"h-1.5 w-full rounded-full bg-[#D7E2EC] overflow-hidden\" data-kid=\"1-2-2-1-2-3-2-4-2\" data-name=\"progress bar track\">\n                                    <div class=\"h-full w-[37%] rounded-full bg-[#2B68E8]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2-3-2-4-2-1\" data-name=\"progress bar fill\" data-reason=\"width updated by progress script\">\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </section>\n                    <!-- ===== Destructive zone — separate ===== -->\n                    <section class=\"mt-10\" data-kid=\"1-2-2-1-2-4\" data-name=\"administrative section\">\n                        <p class=\"text-[10.5px] uppercase tracking-[0.09em] text-[#52677C]/70 font-semibold mb-2.5\" data-kid=\"1-2-2-1-2-4-1\" data-name=\"admin header text\">\n                            Zona administrativa · no forma parte de la importación\n                        </p>\n                        <div class=\"rounded-[10px] border border-[#D7E2EC] bg-white px-5 py-4\" data-kid=\"1-2-2-1-2-4-2\" data-name=\"admin card\">\n                            <div class=\"flex items-start justify-between gap-8\" data-kid=\"1-2-2-1-2-4-2-1\" data-name=\"admin actions container\">\n                                <div data-kid=\"1-2-2-1-2-4-2-1-1\" data-name=\"admin card content\">\n                                    <h3 class=\"text-[13.5px] font-semibold text-[#52677C] flex items-center gap-2\" data-kid=\"1-2-2-1-2-4-2-1-1-1\" data-name=\"admin action title\">\n                                        <i class=\"ti ti-database-off text-[16px]\" data-kid=\"1-2-2-1-2-4-2-1-1-1-1\" data-name=\"admin icon\">\n                                        </i>\n                                        Restablecer transacciones\n                                    </h3>\n                                    <p class=\"text-[12px] text-[#52677C]/90 mt-1 max-w-[460px]\" data-kid=\"1-2-2-1-2-4-2-1-1-2\" data-name=\"admin description text\">\n                                        Borra todas las transacciones registradas antes de importar una plantilla actualizada.\n                                    </p>\n                                    <label class=\"flex items-center gap-2.5 mt-3 cursor-pointer\" data-kid=\"1-2-2-1-2-4-2-1-1-3\" data-name=\"confirmation checkbox\">\n                                        <input class=\"h-4 w-4 accent-[#B5423C]\" data-kid=\"1-2-2-1-2-4-2-1-1-3-1\" data-name=\"checkbox input\" type=\"checkbox\"/>\n                                        <span class=\"text-[12.5px] text-[#52677C]\" data-kid=\"1-2-2-1-2-4-2-1-1-3-2\" data-name=\"confirmation label\">\n                                            Confirmo que quiero borrar todas las transacciones\n                                        </span>\n                                    </label>\n                                </div>\n                                <div class=\"shrink-0 text-right\" data-kid=\"1-2-2-1-2-4-2-1-2\" data-name=\"action button area\">\n                                    <button class=\"flex items-center gap-2 h-9 px-3.5 rounded-[7px] border border-[#B5423C]/60 bg-white text-[#B5423C] text-[12.5px] font-semibold hover:bg-[#B5423C]/[0.05] transition-colors\" data-kid=\"1-2-2-1-2-4-2-1-2-1\" data-name=\"reset database button\">\n                                        <i class=\"ti ti-trash text-[15px]\" data-kid=\"1-2-2-1-2-4-2-1-2-1-1\" data-name=\"trash icon\">\n                                        </i>\n                                        Borrar todas las transacciones\n                                    </button>\n                                    <p class=\"text-[11px] text-[#52677C]/70 mt-2\" data-kid=\"1-2-2-1-2-4-2-1-2-2\" data-name=\"backup note\">\n                                        Se guarda un respaldo automático en\n                                        <span class=\"mono\" data-kid=\"1-2-2-1-2-4-2-1-2-2-1\" data-name=\"backup directory path\">\n                                            /backups\n                                        </span>\n                                        .\n                                        <br data-kid=\"1-2-2-1-2-4-2-1-2-2-2\" data-name=\"line break\"/>\n                                        Los activos fijos no se borran.\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                    </section>\n                </div>\n            </div>\n        </div>\n    </main>\n</div>\n",
