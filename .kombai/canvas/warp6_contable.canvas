—\n                                </td>\n                                <td class=\"px-3 py-2.5 border-l border-[#E4ECE5] text-[#2F684B] text-[12px] font-medium\" data-dynamic=\"true\" data-kid=\"1-3-4-2-2-1-2-5-9\" data-name=\"jul status label\" data-reason=\"label text and color updated based on tax status\">\n                                    ✓ Al día\n                                </td>\n                            </tr>\n                            <tr class=\"rowline bg-[#FBF6EF]\" data-kid=\"1-3-4-2-2-1-2-6\">\n                                <td class=\"px-3 py-2.5 font-semibold\" data-kid=\"1-3-4-2-2-1-2-6-1\">\n                                    Ago\n                                </td>\n                                <td class=\"px-2 py-2.5 mono text-right border-l border-[#E4ECE5]\" data-dynamic=\"true\" data-kid=\"1-3-4-2-2-1-2-6-2\" data-name=\"aug VAT tax determination\" data-reason=\"value updated from tax database\">\n                                    8.120\n                                </td>\n                                <td class=\"px-2 py-2.5 mono text-right\" data-dynamic=\"true\" data-kid=\"1-3-4-2-2-1-2-6-3\" data-name=\"aug IT tax determination\" data-reason=\"value updated from tax database\">\n                                    1.870\n                                </td>\n                                <td class=\"px-2 py-2.5 mono text-right font-medium\" data-dynamic=\"true\" data-kid=\"1-3-4-2-2-1-2-6-4\" data-name=\"aug total tax determination\" data-reason=\"value updated from tax database\">\n                                    9.990\n                                </td>\n                                <td class=\"px-2 py-2.5 mono text-right border-l border-[#E4ECE5]\" data-dynamic=\"true\" data-kid=\"1-3-4-2-2-1-2-6-5\" data-name=\"aug VAT payment registered\" data-reason=\"value updated from tax database\">\n                                    6.000\n                                </td>\n                                <td class=\"px-2 py-2.5 mono text-right\" data-dynamic=\"true\" data-kid=\"1-3-4-2-2-1-2-6-6\" data-name=\"aug IT payment registered\" data-reason=\"value updated from tax database\">\n                                    1.650\n                                </td>\n                                <td class=\"px-2 py-2.5 mono text-right font-medium\" data-dynamic=\"true\" data-kid=\"1-3-4-2-2-1-2-6-7\" data-name=\"aug total payment registered\" data-reason=\"value updated from tax database\">\n                                    7.650\n                                </td>\n                                <td class=\"px-2 py-2.5 mono text-right border-l border-[#E4ECE5] text-[#A83F36] font-semibold\" data-dynamic=\"true\" data-kid=\"1-3-4-2-2-1-2-6-8\" data-name=\"aug tax difference\" data-reason=\"value updated from tax database\">\n                                    2.340\n                                </td>\n                                <td class=\"px-3 py-2.5 border-l border-[#E4ECE5] text-[#A83F36] text-[12px] font-semibold\" data-dynamic=\"true\" data-kid=\"1-3-4-2-2-1-2-6-9\" data-name=\"aug status label\" data-reason=\"label text and color updated based on tax status\">\n                                    ⚠ Pendiente\n                                </td>\n                            </tr>\n                        </tbody>\n                    </table>\n                </div>\n            </section>\n        </div>\n        <!-- ===== FOOTER ===== -->\n        <footer class=\"pt-2 pb-6 text-center\" data-kid=\"1-3-5\">\n            <p class=\"text-[12px] text-[#526259]\" data-kid=\"1-3-5-1\">\n                WARP6 Solutions S.R.L. · La Paz — Bolivia\n            </p>\n            <p class=\"mono text-[10.5px] text-[#8AA092] mt-1\" data-kid=\"1-3-5-2\">\n                Normativa: Ley 843 · DS 24051 · Sistema Contable v2.0\n            </p>\n        </footer>\n    </main>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js\">\n</script>\n<script>\n    const fmt = v => (v < 0 ? '-' : '') + 'Bs ' + Math.abs(v).toLocaleString('de-DE');\n  new Chart(document.getElementById('flujoChart'), {\n    type: 'bar',\n    data: {\n      labels: ['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep'],\n      datasets: [\n        { label: 'Ingresos', data: [12400,14800,19600,19400,16200,22500,20300,32900,26400], backgroundColor: '#265C8F', stack: 'a', barPercentage: 0.62, categoryPercentage: 0.82 },\n        { label: 'Gastos', data: [-5800,-6900,-8400,-9100,-7600,-11200,-9800,-13400,-12560], backgroundColor: '#2F684B', stack: 'a', barPercentage: 0.62, categoryPercentage: 0.82 },\n        { label: 'Pendiente', data: [0,0,-760,0,0,0,0,-2340,0], backgroundColor: '#9D6318', borderColor: '#9D6318', borderWidth: 6, stack: 'b', barPercentage: 0.3, categoryPercentage: 0.82 }\n      ]\n    },\n    options: {\n      responsive: true, maintainAspectRatio: false,\n      interaction: { mode: 'index', intersect: false },\n      scales: {\n        x: { stacked: true, grid: { display: false }, border: { color: '#C9D6CC' }, ticks: { font: { family: 'Azeret Mono', size: 11 }, color: '#526259' } },\n        y: { stacked: true, grid: { color: '#E4ECE5' }, border: { display: false },\n          ticks: { font: { family: 'Azeret Mono', size: 11 }, color: '#526259', callback: v => (v === 0 ? '0' : (v < 0 ? '-' : '') + Math.abs(v/1000) + 'k') } }\n      },\n      plugins: {\n        legend: { position: 'top', align: 'end', labels: { boxWidth: 10, boxHeight: 10, font: { family: 'Inter Tight', size: 12 }, color: '#19251D' } },\n        tooltip: { backgroundColor: '#19251D', titleFont: { family: 'Inter Tight', size: 12 }, bodyFont: { family: 'Azeret Mono', size: 11.5 }, padding: 10, cornerRadius: 3,\n          callbacks: { label: c => ' ' + c.dataset.label + ': ' + fmt(c.parsed.y) } }\n      }\n    }\n  });\n</script>\n",
