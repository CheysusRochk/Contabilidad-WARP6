      "html": "<link data-kid=\"1\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap');\n  body { font-family: 'Inter', sans-serif; }\n  .mono { font-family: 'IBM Plex Mono', monospace; font-variant-numeric: tabular-nums; }\n  i.ti { line-height: 1; }\n</style>\n<div class=\"flex min-h-screen bg-[#F4F8FC] text-[#17324D]\" data-kid=\"2\">\n    <!-- ============ RAIL IZQUIERDO 228px ============ -->\n    <aside class=\"w-[228px] shrink-0 bg-white border-r border-[#D7E2EC] flex flex-col sticky top-0 h-screen\" data-kid=\"2-1\">\n        <div class=\"h-16 px-5 flex items-center gap-2.5 border-b border-[#D7E2EC]\" data-kid=\"2-1-1\">\n            <div class=\"w-[26px] h-[26px] rounded-[7px] bg-[#2B68E8] flex items-center justify-center\" data-kid=\"2-1-1-1\">\n                <span class=\"mono text-white text-[11px] font-semibold\" data-kid=\"2-1-1-1-1\">\n                    W6\n                </span>\n            </div>\n            <div class=\"leading-tight\" data-kid=\"2-1-1-2\">\n                <div class=\"text-[13.5px] font-semibold tracking-tight\" data-kid=\"2-1-1-2-1\">\n                    WARP6\n                </div>\n                <div class=\"text-[10px] text-[#52677C]\" data-kid=\"2-1-1-2-2\">\n                    Solutions S.R.L.\n                </div>\n            </div>\n        </div>\n        <nav class=\"px-2 pt-4 flex flex-col gap-0.5\" data-kid=\"2-1-2\">\n            <a class=\"flex items-center gap-2.5 h-9 px-3 rounded-[6px] text-[13px] text-[#52677C] font-medium\" data-kid=\"2-1-2-1\">\n                <i class=\"ti ti-layout-dashboard text-[17px]\" data-kid=\"2-1-2-1-1\">\n                </i>\n                Inicio\n            </a>\n            <a class=\"relative flex items-center gap-2.5 h-9 pl-[21px] pr-3 rounded-r-[6px] rounded-l-[3px] border-l-[3px] border-[#2B68E8] bg-[#2B68E8]/[0.06] text-[#2057CB] text-[13px] font-semibold\" data-kid=\"2-1-2-2\">\n                <i class=\"ti ti-list-plus text-[17px]\" data-kid=\"2-1-2-2-1\">\n                </i>\n                Movimientos\n            </a>\n            <a class=\"flex items-center gap-2.5 h-9 px-3 rounded-[6px] text-[13px] text-[#52677C] font-medium\" data-kid=\"2-1-2-3\">\n                <i class=\"ti ti-file-chart-column text-[17px]\" data-kid=\"2-1-2-3-1\">\n                </i>\n                Reportes\n            </a>\n            <a class=\"flex items-center gap-2.5 h-9 px-3 rounded-[6px] text-[13px] text-[#52677C] font-medium\" data-kid=\"2-1-2-4\">\n                <i class=\"ti ti-computer text-[17px]\" data-kid=\"2-1-2-4-1\">\n                </i>\n                Activos\n            </a>\n            <a class=\"flex items-center gap-2.5 h-9 px-3 rounded-[6px] text-[13px] text-[#52677C] font-medium\" data-kid=\"2-1-2-5\">\n                <i class=\"ti ti-file-up text-[17px]\" data-kid=\"2-1-2-5-1\">\n                </i>\n                Importar\n            </a>\n        </nav>\n        <div class=\"mt-auto px-5 py-4 border-t border-[#D7E2EC]\" data-kid=\"2-1-3\">\n            <div class=\"text-[10.5px] text-[#52677C]\" data-kid=\"2-1-3-1\">\n                Ley 843 · DS 24051\n            </div>\n            <div class=\"text-[10px] text-[#52677C]/70 mt-0.5\" data-kid=\"2-1-3-2\">\n                Sistema contable v1.2\n            </div>\n        </div>\n    </aside>\n    <!-- ============ ÁREA PRINCIPAL ============ -->\n    <main class=\"flex-1 min-w-0 flex flex-col\" data-kid=\"2-2\">\n        <!-- Barra superior contextual -->\n        <header class=\"h-16 shrink-0 bg-white border-b border-[#D7E2EC] px-8 flex items-center justify-between\" data-kid=\"2-2-1\">\n            <h1 class=\"text-[16px] font-semibold tracking-tight\" data-kid=\"2-2-1-1\">\n                Movimientos\n            </h1>\n            <div class=\"flex items-center gap-2 h-9 w-[340px] px-3 bg-white border border-[#D7E2EC] rounded-[6px] shrink-0\" data-kid=\"2-2-1-2\" data-name=\"search input field\">\n                <i class=\"ti ti-search text-[15px] text-[#52677C]\" data-kid=\"2-2-1-2-1\">\n                </i>\n                <span class=\"text-[12.5px] text-[#52677C]/70\" data-kid=\"2-2-1-2-2\">\n                    Buscar por detalle, factura o NIT\n                </span>\n            </div>\n        </header>\n        <div class=\"p-8 flex gap-6 items-start\" data-kid=\"2-2-2\">\n            <!-- ============ PANEL IZQUIERDO: NUEVA TRANSACCIÓN ============ -->\n            <section class=\"w-[376px] shrink-0 bg-white border border-[#D7E2EC] rounded-[10px]\" data-kid=\"2-2-2-1\">\n                <div class=\"px-5 h-12 flex items-center justify-between border-b border-[#D7E2EC]\" data-kid=\"2-2-2-1-1\">\n                    <h2 class=\"text-[13.5px] font-semibold\" data-kid=\"2-2-2-1-1-1\">\n                        Nueva transacción\n                    </h2>\n                    <span class=\"text-[11px] text-[#52677C]\" data-kid=\"2-2-2-1-1-2\">\n                        Ley 843\n                    </span>\n                </div>\n                <div class=\"p-5 flex flex-col gap-4\" data-kid=\"2-2-2-1-2\">\n                    <!-- Fecha + Tipo -->\n                    <div class=\"grid grid-cols-2 gap-3\" data-kid=\"2-2-2-1-2-1\">\n                        <div data-kid=\"2-2-2-1-2-1-1\">\n                            <label class=\"block text-[11.5px] font-medium text-[#52677C] mb-1.5\" data-kid=\"2-2-2-1-2-1-1-1\">\n                                Fecha\n                            </label>\n                            <div class=\"h-9 px-3 flex items-center justify-between bg-white border border-[#D7E2EC] rounded-[6px]\" data-kid=\"2-2-2-1-2-1-1-2\">\n                                <span class=\"mono text-[12.5px]\" data-kid=\"2-2-2-1-2-1-1-2-1\">\n                                    12/09/2026\n                                </span>\n                                <i class=\"ti ti-calendar text-[14px] text-[#52677C]\" data-kid=\"2-2-2-1-2-1-1-2-2\">\n                                </i>\n                            </div>\n                        </div>\n                        <div data-kid=\"2-2-2-1-2-1-2\">\n                            <label class=\"block text-[11.5px] font-medium text-[#52677C] mb-1.5\" data-kid=\"2-2-2-1-2-1-2-1\">\n                                Tipo\n                            </label>\n                            <div class=\"h-9 p-[3px] grid grid-cols-2 bg-[#F4F8FC] border border-[#D7E2EC] rounded-[6px]\" data-kid=\"2-2-2-1-2-1-2-2\">\n                                <span class=\"flex items-center justify-center text-[12px] font-medium text-[#52677C] rounded-[4px]\" data-kid=\"2-2-2-1-2-1-2-2-1\">\n                                    Ingreso\n                                </span>\n                                <span class=\"flex items-center justify-center text-[12px] font-semibold text-[#17324D] bg-white border border-[#D7E2EC] rounded-[4px]\" data-kid=\"2-2-2-1-2-1-2-2-2\">\n                                    Gasto\n                                </span>\n                            </div>\n                        </div>\n                    </div>\n                    <!-- Categoría + Método de pago -->\n                    <div class=\"grid grid-cols-2 gap-3\" data-kid=\"2-2-2-1-2-2\">\n                        <div data-kid=\"2-2-2-1-2-2-1\">\n                            <label class=\"block text-[11.5px] font-medium text-[#52677C] mb-1.5\" data-kid=\"2-2-2-1-2-2-1-1\">\n                                Categoría\n                            </label>\n                            <div class=\"h-9 px-3 flex items-center justify-between bg-white border border-[#D7E2EC] rounded-[6px]\" data-kid=\"2-2-2-1-2-2-1-2\">\n                                <span class=\"text-[12.5px]\" data-kid=\"2-2-2-1-2-2-1-2-1\">\n 